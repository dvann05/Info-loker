---
const directLink = "https://uplcm.com/4/12373672";
---

<div class="monetag-wrap">
  <span class="ad-label">IKLAN</span>
  <a
    href={directLink}
    target="_blank"
    rel="sponsored nofollow noopener noreferrer"
    class="monetag-banner"
  >
    <span class="ad-icon">↗</span>
    <span class="ad-copy">
      <strong>Penawaran menarik untuk Anda</strong>
      <small>Klik untuk melihat informasi selengkapnya</small>
    </span>
    <span class="ad-button">Lihat</span>
  </a>
</div>

<style>
  .monetag-wrap {
    width: min(468px, calc(100% - 32px));
    margin: 24px auto;
    font-family: inherit;
  }

  .ad-label {
    display: block;
    text-align: center;
    color: #8491a3;
    font-size: 9px;
    font-weight: 700;
    margin-bottom: 5px;
  }

  .monetag-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 11px 14px;
    box-sizing: border-box;
    border: 1px solid #dce5ef;
    border-radius: 10px;
    background: #f7faff;
    color: #172b4d;
    text-decoration: none;
  }

  .ad-icon {
    display: grid;
    place-items: center;
    flex: 0 0 38px;
    height: 38px;
    border-radius: 9px;
    background: #e2efff;
    color: #1769c2;
    font-size: 23px;
  }

  .ad-copy {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
  }

  .ad-copy strong { font-size: 12px; }
  .ad-copy small { color: #64748b; font-size: 10px; }

  .ad-button {
    padding: 7px 12px;
    border-radius: 6px;
    background: #1769c2;
    color: white;
    font-size: 11px;
    font-weight: bold;
  }
</style>
