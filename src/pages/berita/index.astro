---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabase } from "../../lib/supabase";
import { formatJakartaDate, getNewsDetailPath } from "../../lib/seo";

let initialNews: Array<{
  slug: string;
  title: string;
  excerpt: string | null;
  category: string;
  image_url: string | null;
  image_alt: string | null;
  source_name: string | null;
  published_at: string | null;
}> = [];
let initialTotalNews = 0;

try {
  const { data, count } = await supabase
    .from("news")
    .select(
      "slug,title,excerpt,category,image_url,image_alt,source_name,published_at",
      { count: "exact" }
    )
    .eq("status", "published")
    .not("slug", "is", null)
    .order("published_at", { ascending: false })
    .order("slug", { ascending: true })
    .range(0, 11);
  initialNews = (data ?? []).filter((n) => Boolean(n.slug));
  initialTotalNews = count ?? initialNews.length;
} catch {
  initialNews = [];
}

const hasMoreInitial = initialNews.length > 0 && initialNews.length < initialTotalNews;
---

<BaseLayout
  title="Berita Dunia Kerja Terbaru | Info Loker Kita"
  description="Berita industri, perusahaan, dunia kerja, dan tips karier terbaru dari Info Loker Kita."
>
  <header class="site-header">
    <div class="container navbar">
      <a class="brand" href="/" aria-label="Info Loker Kita beranda">
        <img src="/favicon.svg" alt="Logo Info Loker Kita" width="34" height="34" class="brand-logo-icon" />
        <span>Info Loker <span>Kita</span></span>
      </a>
      <nav class="nav-links" aria-label="Navigasi utama">
        <a href="/">Beranda</a>
        <a href="/lowongan/">Lowongan</a>
        <a href="/berita/">Berita</a>
      </nav>
    </div>
  </header>

  <main class="section">
    <div class="container">
      <nav class="portal-switcher" aria-label="Pilih kategori informasi">
        <a href="/lowongan/" class="portal-card">
          <span class="portal-icon">💼</span>
          <span>
            <strong>Lowongan Kerja</strong>
            <small>Temukan pekerjaan terbaru</small>
          </span>
        </a>

        <a href="/berita/" class="portal-card is-active" aria-current="page">
          <span class="portal-icon">📰</span>
          <span>
            <strong>Berita</strong>
            <small>Informasi dan berita dunia kerja</small>
          </span>
        </a>
      </nav>

      <header class="news-intro">
        <h1>Berita Dunia Kerja</h1>
        <p>
          Ikuti perkembangan industri, perusahaan, dunia kerja, dan informasi karier di Indonesia.
        </p>
      </header>

      <section class="news-section" aria-labelledby="news-heading">
        <div class="news-search">
          <label for="news-search-input">Cari berita</label>
          <input
            id="news-search-input"
            type="search"
            placeholder="Cari berdasarkan judul berita..."
            autocomplete="off"
          />
        </div>

        <div id="news-status" class="news-status" aria-live="polite">
          {initialNews.length > 0 ? `Menampilkan ${initialNews.length} dari ${initialTotalNews} berita` : "Memuat berita terbaru..."}
        </div>

        <div
          id="news-list"
          class="news-grid"
          data-ssr={initialNews.length > 0 ? "1" : "0"}
          data-total={String(initialTotalNews)}
        >
          {initialNews.map((article) => (
            <article class="news-card">
              {article.image_url ? (
                <div class="news-image-wrapper">
                  <img
                    src={article.image_url}
                    alt={article.image_alt || article.title}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ) : (
                <div class="news-image-placeholder">📰</div>
              )}
              <div class="news-card-body">
                <span class="news-category">{article.category}</span>
                <h3 class="news-card-title">
                  <a href={getNewsDetailPath(article.slug)}>{article.title}</a>
                </h3>
                <time class="news-date" datetime={article.published_at ?? undefined}>
                  {formatJakartaDate(article.published_at)}
                </time>
                {article.excerpt && <p class="news-excerpt">{article.excerpt}</p>}
                {article.source_name && <p class="news-source">Sumber: {article.source_name}</p>}
              </div>
            </article>
          ))}
        </div>

        <button id="load-more-news" class="load-more-news" type="button" hidden={!hasMoreInitial}>
          Muat Berita Lainnya
        </button>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { supabase } from "../../lib/supabase";

  const list = document.querySelector<HTMLElement>("#news-list");
  const status = document.querySelector<HTMLElement>("#news-status");
  const searchInput = document.querySelector<HTMLInputElement>("#news-search-input");
  const loadMoreButton = document.querySelector<HTMLButtonElement>("#load-more-news");

  const PAGE_SIZE = 12;
  const hasSsr = list?.dataset.ssr === "1";
  let currentPage = hasSsr ? 1 : 0;
  let totalNews = Number(list?.dataset.total || "0");
  let isLoading = false;
  let searchTerm = "";
  let searchTimer: ReturnType<typeof setTimeout> | undefined;
  let requestVersion = 0;

  function createEl(tag: string, className: string, text?: string) {
    const el = document.createElement(tag);
    el.className = className;
    if (text) el.textContent = text;
    return el;
  }

  function validUrl(value: string | null) {
    if (!value) return null;
    if (value.startsWith("/")) return value;
    try {
      const url = new URL(value);
      if (url.protocol === "https:" || url.protocol === "http:") return url.href;
    } catch {
      return null;
    }
    return null;
  }

  function formatDate(value: string | null) {
    if (!value) return "Tanggal tidak tersedia";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "Tanggal tidak tersedia";
    return new Intl.DateTimeFormat("id-ID", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(date);
  }

  function buildNewsCard(article: {
    slug: string;
    title: string;
    excerpt: string | null;
    category: string;
    image_url: string | null;
    image_alt: string | null;
    source_name: string | null;
    published_at: string | null;
  }) {
    const card = createEl("article", "news-card");
    const imageUrl = validUrl(article.image_url);

    if (imageUrl) {
      const imageWrapper = createEl("div", "news-image-wrapper");
      const image = document.createElement("img");
      image.src = imageUrl;
      image.alt = article.image_alt || article.title;
      image.loading = "lazy";
      image.decoding = "async";
      image.addEventListener("error", () => {
        imageWrapper.replaceChildren(createEl("span", "news-image-fallback", "📰"));
      }, { once: true });
      imageWrapper.appendChild(image);
      card.appendChild(imageWrapper);
    } else {
      card.appendChild(createEl("div", "news-image-placeholder", "📰"));
    }

    const body = createEl("div", "news-card-body");
    body.appendChild(createEl("span", "news-category", article.category));

    const title = createEl("h3", "news-card-title");
    const titleLink = document.createElement("a");
    titleLink.href = `/berita/${encodeURIComponent(article.slug)}/`;
    titleLink.textContent = article.title;
    title.appendChild(titleLink);
    body.appendChild(title);

    const time = createEl("time", "news-date", formatDate(article.published_at));
    if (article.published_at) time.setAttribute("datetime", article.published_at);
    body.appendChild(time);

    if (article.excerpt) body.appendChild(createEl("p", "news-excerpt", article.excerpt));
    if (article.source_name) body.appendChild(createEl("p", "news-source", `Sumber: ${article.source_name}`));

    card.appendChild(body);
    return card;
  }

  async function loadNews() {
    if (!list || !status || isLoading) return;

    isLoading = true;
    const thisRequest = requestVersion;

    if (currentPage === 0) {
      status.textContent = "Memuat berita...";
    }

    if (loadMoreButton) {
      loadMoreButton.disabled = true;
      loadMoreButton.textContent = "Memuat...";
    }

    try {
      const from = currentPage * PAGE_SIZE;
      const to = from + PAGE_SIZE - 1;

      let query = supabase
        .from("news")
        .select(
          "slug,title,excerpt,category,image_url,image_alt,source_name,published_at",
          { count: "exact" }
        )
        .eq("status", "published")
        .not("slug", "is", null)
        .order("published_at", { ascending: false })
        .range(from, to);

      if (searchTerm) {
        query = query.ilike("title", `%${searchTerm}%`);
      }

      const { data, error, count } = await query;

      if (thisRequest !== requestVersion) return;
      if (error) throw error;

      totalNews = count ?? 0;

      if (!data || data.length === 0) {
        if (currentPage === 0) {
          list.replaceChildren();
          status.textContent = "Belum ada berita yang sesuai.";
        }
        if (loadMoreButton) loadMoreButton.hidden = true;
        return;
      }

      const frag = document.createDocumentFragment();
      for (const article of data) {
        frag.appendChild(buildNewsCard(article));
      }

      if (currentPage === 0) {
        list.replaceChildren(frag);
      } else {
        list.appendChild(frag);
      }

      const displayedNews = Math.min((currentPage + 1) * PAGE_SIZE, totalNews);
      status.textContent = `Menampilkan ${displayedNews} dari ${totalNews} berita`;
      currentPage++;

      if (loadMoreButton) {
        loadMoreButton.hidden = displayedNews >= totalNews;
        loadMoreButton.disabled = false;
        loadMoreButton.textContent = "Muat Berita Lainnya";
      }
    } catch (error) {
      if (thisRequest !== requestVersion) return;
      console.error("Gagal memuat berita:", error);
      status.textContent = "Berita belum dapat dimuat. Silakan coba lagi.";
      if (loadMoreButton) {
        loadMoreButton.hidden = false;
        loadMoreButton.disabled = false;
        loadMoreButton.textContent = "Coba Lagi";
      }
    } finally {
      isLoading = false;
    }
  }

  searchInput?.addEventListener("input", () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      searchTerm = searchInput.value.trim();
      currentPage = 0;
      totalNews = 0;
      requestVersion++;
      if (loadMoreButton) loadMoreButton.hidden = true;
      void loadNews();
    }, 350);
  });

  loadMoreButton?.addEventListener("click", () => void loadNews());

  if (!hasSsr) {
    void loadNews();
  }
</script>

<style is:global>
  .news-section {
    margin-top: 24px;
  }

  .news-search {
    margin-bottom: 18px;
  }

  .news-search label {
    display: block;
    margin-bottom: 6px;
    font-size: 13.5px;
    font-weight: 700;
  }

  .news-search input {
    display: block;
    width: 100%;
    max-width: 520px;
    padding: 11px 14px;
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 10px;
    background: var(--surface, #fff);
    color: var(--text, #172b4d);
    font: inherit;
  }

  .news-status {
    margin-bottom: 16px;
    color: var(--muted, #5a6a82);
    font-size: 13.5px;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .news-card {
    overflow: hidden;
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 14px;
    background: var(--surface, #fff);
    content-visibility: auto;
    contain-intrinsic-size: auto 320px;
    transition: border-color 0.15s ease;
  }

  .news-card:hover {
    border-color: #93c5fd;
  }

  .news-image-wrapper,
  .news-image-placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f1f5f9;
  }

  .news-image-wrapper img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .news-image-placeholder,
  .news-image-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 38px;
  }

  .news-card-body {
    padding: 16px;
  }

  .news-category {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 9999px;
    background: var(--primary-subtle, #e8f3fc);
    color: var(--primary, #0b6bcb);
    font-size: 11.5px;
    font-weight: 700;
  }

  .news-card-title {
    margin: 10px 0 6px;
    font-size: 16.5px;
    line-height: 1.4;
  }

  .news-card-title a:hover {
    color: var(--primary, #0b6bcb);
  }

  .news-date {
    display: block;
    color: var(--muted, #5a6a82);
    font-size: 12px;
  }

  .news-excerpt {
    margin: 10px 0;
    color: var(--muted, #5a6a82);
    font-size: 13.5px;
    line-height: 1.6;
  }

  .news-source {
    margin: 8px 0 0;
    color: var(--muted, #5a6a82);
    font-size: 12px;
  }

  .load-more-news {
    display: block;
    margin: 24px auto 0;
    padding: 12px 24px;
    border: 0;
    border-radius: 10px;
    background: var(--primary, #0b6bcb);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
  }

  .load-more-news:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .load-more-news[hidden] {
    display: none;
  }

  @media (max-width: 850px) {
    .news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .news-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
