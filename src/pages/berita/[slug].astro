---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabase } from "../../lib/supabase";

export async function getStaticPaths() {
  const { data, error } = await supabase
    .from("news")
    .select("slug")
    .eq("status", "published");

  if (error) {
    throw new Error(`Gagal mengambil daftar berita: ${error.message}`);
  }

  return (data ?? []).map((item) => ({
    params: { slug: item.slug }
  }));
}

const { slug } = Astro.params;

const { data: article, error } = await supabase
  .from("news")
  .select(`
    title,
    content,
    excerpt,
    image_url,
    image_alt,
    category,
    source_name,
    source_url,
    published_at
  `)
  .eq("slug", slug)
  .eq("status", "published")
  .maybeSingle();

const validUrl = (value: string | null) => {
  if (!value) return null;

  try {
    const url = new URL(value);

    if (url.protocol === "https:" || url.protocol === "http:") {
      return url.href;
    }
  } catch {
    return null;
  }

  return null;
};

const imageUrl = validUrl(article?.image_url ?? null);
const sourceUrl = validUrl(article?.source_url ?? null);

const formattedDate = article?.published_at
  ? new Intl.DateTimeFormat("id-ID", {
      day: "numeric",
      month: "long",
      year: "numeric"
    }).format(new Date(article.published_at))
  : "Tanggal tidak tersedia";
---

{article && !error ? (
  <BaseLayout
    title={`${article.title} — InfoLoker`}
    description={article.excerpt || article.title}
  >
    <main class="article-container">
      <a href="/berita/" class="back-link">
        ← Kembali ke daftar berita
      </a>

      <article class="article">
        <header class="article-header">
          <span class="category">{article.category}</span>
          <h1>{article.title}</h1>
          <time datetime={article.published_at ?? undefined}>
            {formattedDate}
          </time>
        </header>

        {imageUrl && (
          <figure class="hero-image">
            <img
              src={imageUrl}
              alt={article.image_alt || article.title}
              fetchpriority="high"
            />
          </figure>
        )}

        <div
          class="article-content"
          set:html={article.content.replace(/\\n/g, "\n")}
        />

        <footer class="article-footer">
          <h2>Sumber Berita</h2>
          <p>{article.source_name || "Sumber tidak dicantumkan"}</p>

          {sourceUrl && (
            <a
              href={sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Kunjungi sumber asli ↗
            </a>
          )}
        </footer>
      </article>

      <a href="/berita/" class="back-bottom">
        ← Kembali ke semua berita
      </a>
    </main>
  </BaseLayout>
) : (
  <BaseLayout
    title="Berita Tidak Ditemukan — InfoLoker"
    description="Berita yang kamu cari tidak ditemukan."
  >
    <main class="not-found">
      <div class="not-found-icon">📰</div>
      <h1>Berita Tidak Ditemukan</h1>
      <p>
        Berita mungkin sudah tidak tersedia atau alamat yang kamu buka salah.
      </p>
      <a href="/berita/">Kembali ke daftar berita</a>
    </main>
  </BaseLayout>
)}

<style>
  .article-container {
    width: min(100% - 32px, 850px);
    margin: 40px auto 70px;
  }

  .back-link,
  .back-bottom {
    display: inline-block;
    color: var(--primary, #2563eb);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover,
  .back-bottom:hover {
    text-decoration: underline;
  }

  .article {
    margin-top: 28px;
    padding: 30px;
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 18px;
    background: var(--surface, #fff);
  }

  .article-header {
    margin-bottom: 26px;
  }

  .category {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    background: #eff6ff;
    color: #2563eb;
    font-size: 12px;
    font-weight: 700;
  }

  .article-header h1 {
    margin: 18px 0 12px;
    font-size: clamp(27px, 5vw, 38px);
    line-height: 1.3;
    color: var(--text, #0f172a);
  }

  .article-header time {
    color: var(--muted, #64748b);
    font-size: 14px;
  }

  .hero-image {
    margin: 0 0 30px;
    overflow: hidden;
    border-radius: 14px;
    background: #f1f5f9;
  }

  .hero-image img {
    display: block;
    width: 100%;
    max-height: 480px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .article-content {
    color: var(--text, #334155);
    font-size: 16px;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .article-content p {
    margin: 0 0 20px;
  }

  .article-footer {
    margin-top: 38px;
    padding: 22px;
    border-radius: 12px;
    background: #f8fafc;
  }

  .article-footer h2 {
    margin: 0 0 10px;
    font-size: 18px;
  }

  .article-footer p {
    margin: 0 0 12px;
    color: #475569;
  }

  .article-footer a {
    color: #2563eb;
    font-weight: 700;
    text-decoration: none;
  }

  .back-bottom {
    margin-top: 28px;
  }

  .not-found {
    width: min(100% - 32px, 600px);
    margin: 90px auto;
    text-align: center;
  }

  .not-found-icon {
    font-size: 52px;
  }

  .not-found h1 {
    color: var(--text, #0f172a);
  }

  .not-found p {
    color: var(--muted, #64748b);
    line-height: 1.7;
  }

  .not-found a {
    display: inline-block;
    margin-top: 16px;
    padding: 12px 20px;
    border-radius: 10px;
    background: #2563eb;
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .article {
      padding: 20px;
    }

    .article-container {
      margin-top: 25px;
    }
  }
</style>
