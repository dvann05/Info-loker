---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Daftar Lowongan Kerja Terbaru | Info Loker Kita"
  description="Cari lowongan kerja terbaru di Info Loker Kita berdasarkan posisi, perusahaan, dan kota di seluruh Indonesia. Periksa sumber resmi sebelum melamar."
>

  <header class="site-header">
    <div class="container navbar">
      <a class="brand" href="/" aria-label="Info Loker Kita beranda">
        <img src="/favicon.svg" alt="Logo Info Loker Kita" width="38" height="38" class="brand-logo-icon" />
        <span>Info Loker <span>Kita</span></span>
      </a>  <nav class="nav-links" aria-label="Navigasi utama">
    <a href="/">Beranda</a>
    <a href="/lowongan">Lowongan</a>
  </nav>
</div>

  </header>  <main class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <h1>Daftar lowongan kerja</h1>
          <p>Temukan peluang kerja dan periksa sumber rekrutmen resminya.</p>
        </div>
      </div>  <form id="search-form" class="search-panel">
    <div class="search-field">
      <label for="keyword">Posisi atau perusahaan</label>
      <input
        id="keyword"
        type="search"
        placeholder="Contoh: Operator Produksi"
      />
    </div>

    <div class="search-field">
        <label for="province">Provinsi</label>
        <select id="province"><option value="">Memuat provinsi...</option></select>
      </div>
      <div class="search-field">
        <label for="city">Kota/Kabupaten</label>
        <select id="city" disabled><option value="">Pilih provinsi dahulu</option></select>
      </div>
      <div class="search-field">
        <label for="district">Kecamatan</label>
        <select id="district" disabled><option value="">Pilih kota/kabupaten dahulu</option></select>
      </div>

    <button class="btn btn-primary" type="submit">Cari ↗</button>
  </form>

  <p id="job-status" role="status" aria-live="polite">
    Memuat lowongan...
  </p>

  <div id="job-list" class="job-grid"></div>

  <nav id="pagination" class="pagination" aria-label="Navigasi halaman"></nav>

  <p class="back-home">
    <a href="/">← Kembali ke beranda</a>
  </p>
</div>

  </main>  <footer class="site-footer">
    <div class="container">
      <div class="footer-columns">
        <div class="footer-col brand-col">
          <a class="brand" href="/" aria-label="Info Loker Kita beranda">
            <img src="/favicon.svg" alt="Logo Info Loker Kita" width="38" height="38" class="brand-logo-icon" />
            <span>Info Loker <span>Kita</span></span>
          </a>
          <p class="footer-description">
            Info Loker Kita adalah portal informasi lowongan kerja resmi di Indonesia. Dihubungkan dengan data rekrutmen terpercaya untuk karir yang transparan, aman, dan 100% bebas biaya pungutan.
          </p>
          <div class="footer-badge">🛡️ Bebas Pungutan Biaya 100%</div>
        </div>

        <div class="footer-col">
          <h4>Navigasi Portal</h4>
          <ul class="footer-nav-list">
            <li><a href="/">Beranda Utama</a></li>
            <li><a href="/lowongan/">Daftar Lowongan Kerja</a></li>
            <li><a href="/berita/">Berita Dunia Kerja</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Kategori Lowongan</h4>
          <ul class="footer-nav-list">
            <li><a href="/lowongan/?q=Operator">Operator Produksi</a></li>
            <li><a href="/lowongan/?q=Gudang">Logistik & Gudang</a></li>
            <li><a href="/lowongan/?q=Admin">Administrasi Kantor</a></li>
            <li><a href="/lowongan/?q=Sales">Ritel & Pemasaran</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Verifikasi & Regulasi</h4>
          <p class="footer-text-muted">
            Info Loker Kita tidak pernah memungut biaya apapun dari pelamar kerja. Waspadai segala bentuk penipuan tiket travel atau rekrutmen berbayar.
          </p>
          <a href="https://kemnaker.go.id" target="_blank" rel="noopener noreferrer" class="footer-external-link">
            Situs Resmi Kemnaker RI ↗
          </a>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© {new Date().getFullYear()} Info Loker Kita. Hak cipta dilindungi.</p>
        <p class="footer-subtext">Informasi bersumber dari portal resmi rekrutmen perusahaan dan Karirhub Kemnaker.</p>
      </div>
    </div>
  </footer>  <script>
    import { supabase } from "../../lib/supabase";
    import { setupLocationFilters } from "../../scripts/location-filter";

    type Job = {
      slug: string;
      title: string;
      company_name: string;
      company_logo: string | null;
      location: string;
      province: string | null;
      city: string | null;
      district: string | null;
      employment_type: string | null;
      description: string;
      source_url: string;
      apply_url: string | null;
      published_at: string | null;
      deadline: string | null;
    };

    const PAGE_SIZE = 9;
    const form = document.querySelector<HTMLFormElement>("#search-form");
    const keywordInput = document.querySelector<HTMLInputElement>("#keyword");
    const provinceInput = document.querySelector<HTMLSelectElement>("#province");
    const cityInput = document.querySelector<HTMLSelectElement>("#city");
    const districtInput = document.querySelector<HTMLSelectElement>("#district");
    const jobList = document.querySelector<HTMLDivElement>("#job-list");
    const jobStatus = document.querySelector<HTMLParagraphElement>("#job-status");
    const pagination = document.querySelector<HTMLElement>("#pagination");

    const initialParams = new URLSearchParams(window.location.search);
    if (keywordInput) keywordInput.value = initialParams.get("q") || "";


    let currentPage = Math.max(1, Number(initialParams.get("page")) || 1);

    function localToday() {
      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, "0");
      const day = String(now.getDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    }

    function escapeLike(value: string) {
      return value.replace(/[\\%_]/g, "\\$&");
    }

    function makePageUrl(page: number) {
      const params = new URLSearchParams();
      const keyword = (keywordInput?.value || "").trim();
      const province = (provinceInput?.value || "").trim();
      const city = (cityInput?.value || "").trim();
      const district = (districtInput?.value || "").trim();

      if (page > 1) params.set("page", String(page));
      if (keyword) params.set("q", keyword);
      if (province) params.set("provinsi", province);
      if (city) params.set("kota", city);
      if (district) params.set("kecamatan", district);

      const query = params.toString();
      return query ? `/lowongan/?${query}` : "/lowongan/";
    }

    function addPageButton(label: string, page: number, active = false, disabled = false) {
      if (!pagination) return;

      const link = document.createElement("a");
      link.textContent = label;
      link.href = disabled ? "#" : makePageUrl(page);
      link.className = "pagination-link";
      if (active) link.classList.add("is-active");
      if (disabled) link.classList.add("is-disabled");

      if (active) link.setAttribute("aria-current", "page");
      if (disabled) link.setAttribute("aria-disabled", "true");

      pagination.append(link);
    }

    function renderPagination(totalPages: number) {
      if (!pagination) return;
      pagination.replaceChildren();

      if (totalPages <= 1) return;

      addPageButton("<<", currentPage - 1, false, currentPage === 1);

      const start = Math.max(
        1,
        Math.min(currentPage - 2, totalPages - 4)
      );
      const end = Math.min(totalPages, start + 4);

      for (let page = start; page <= end; page++) {
        addPageButton(String(page), page, page === currentPage);
      }

      addPageButton(">>", currentPage + 1, false, currentPage >= totalPages);
    }

    function renderSkeletons(count = 9) {
      if (!jobList) return;
      jobList.replaceChildren();

      for (let i = 0; i < count; i++) {
        const card = document.createElement("div");
        card.className = "job-skeleton-card";

        const header = document.createElement("div");
        header.className = "job-skeleton-header";

        const avatar = document.createElement("div");
        avatar.className = "skeleton job-skeleton-avatar";

        const headerText = document.createElement("div");
        headerText.style.display = "flex";
        headerText.style.flexDirection = "column";
        headerText.style.gap = "8px";
        headerText.style.flex = "1";

        const title = document.createElement("div");
        title.className = "skeleton job-skeleton-title";

        const company = document.createElement("div");
        company.className = "skeleton job-skeleton-text";

        headerText.append(title, company);
        header.append(avatar, headerText);

        const badges = document.createElement("div");
        badges.className = "job-skeleton-badges";
        const b1 = document.createElement("div");
        b1.className = "skeleton job-skeleton-badge";
        const b2 = document.createElement("div");
        b2.className = "skeleton job-skeleton-badge";
        badges.append(b1, b2);

        const desc = document.createElement("div");
        desc.className = "skeleton job-skeleton-desc";

        const footer = document.createElement("div");
        footer.className = "job-skeleton-footer";
        const link = document.createElement("div");
        link.className = "skeleton job-skeleton-text";
        link.style.width = "40%";
        const btn = document.createElement("div");
        btn.className = "skeleton job-skeleton-btn";
        footer.append(link, btn);

        card.append(header, badges, desc, footer);
        jobList.append(card);
      }
    }

    function render(items: Job[], total: number) {
      if (!jobList || !jobStatus) return;

      jobList.replaceChildren();

      if (!items.length) {
        jobStatus.textContent = "0 lowongan ditemukan.";
        const empty = document.createElement("div");
        empty.className = "empty-state";

        const icon = document.createElement("div");
        icon.className = "empty-state-icon";
        icon.textContent = "🔍";

        const title = document.createElement("h3");
        title.className = "empty-state-title";
        title.textContent = "Belum ada lowongan yang sesuai";

        const desc = document.createElement("p");
        desc.className = "empty-state-desc";
        desc.textContent = "Coba gunakan kata kunci lain atau bersihkan pilihan filter lokasi.";

        const resetBtn = document.createElement("button");
        resetBtn.className = "btn btn-secondary";
        resetBtn.textContent = "Reset Pencarian";
        resetBtn.type = "button";
        resetBtn.onclick = () => {
          if (keywordInput) keywordInput.value = "";
          if (provinceInput) {
            provinceInput.value = "";
            provinceInput.dispatchEvent(new Event("change"));
          }
          currentPage = 1;
          loadJobs();
        };

        empty.append(icon, title, desc, resetBtn);
        jobList.append(empty);
        return;
      }

      jobStatus.textContent =
        `${total} lowongan ditemukan. Halaman ${currentPage}.`;

      for (const job of items) {
        const card = document.createElement("article");
        card.className = "job-card";

        const company = document.createElement("div");
        company.className = "job-company";

        const logo = document.createElement("div");
        logo.className = "company-logo";

        const initials = (job.company_name || "PT")
          .split(/\s+/)
          .filter(Boolean)
          .slice(0, 2)
          .map((word) => word[0])
          .join("")
          .toUpperCase();

        if (job.company_logo) {
          const image = document.createElement("img");
          image.alt = `Logo ${job.company_name}`;
          image.width = 44;
          image.height = 44;
          image.loading = "lazy";
          image.decoding = "async";
          image.referrerPolicy = "no-referrer";
          image.src = job.company_logo;
          image.addEventListener("error", () => {
            logo.replaceChildren();
            logo.textContent = initials;
            logo.setAttribute("aria-label", `Inisial perusahaan ${job.company_name}`);
          }, { once: true });
          logo.append(image);
        } else {
          logo.textContent = initials;
        }

        const companyName = document.createElement("span");
        companyName.textContent = job.company_name || "Perusahaan tidak diketahui";

        company.append(logo, companyName);

        const title = document.createElement("h2");
        title.textContent = job.title;

        const metaRow = document.createElement("div");
        metaRow.className = "job-meta-row";

        const locBadge = document.createElement("span");
        locBadge.className = "job-badge job-badge-location";
        locBadge.textContent = `📍 ${job.location}`;

        const typeBadge = document.createElement("span");
        typeBadge.className = "job-badge job-badge-type";
        typeBadge.textContent = job.employment_type || "Penuh Waktu";

        metaRow.append(locBadge, typeBadge);

        if (job.published_at) {
          const dateBadge = document.createElement("span");
          dateBadge.className = "job-badge job-badge-date";
          dateBadge.textContent = `⏱ ${new Date(job.published_at).toLocaleDateString("id-ID", { day: "numeric", month: "short", year: "numeric" })}`;
          metaRow.append(dateBadge);
        }

        const cleanDescription = (job.description || "")
          .replace(/\\n/g, "\n")
          .replace(/\n{3,}/g, "\n\n")
          .trim();

        const description = document.createElement("p");
        description.textContent = cleanDescription.length > 170
          ? `${cleanDescription.slice(0, 170).trimEnd()}…`
          : cleanDescription;
        description.className = "job-description";

        const actions = document.createElement("div");
        actions.className = "job-card-actions";

        const detail = document.createElement("a");
        detail.href = `/lowongan/${encodeURIComponent(job.slug)}/`;
        detail.textContent = "Lihat detail →";
        detail.className = "job-source";

        const source = document.createElement("a");
        source.href = job.source_url;
        source.target = "_blank";
        source.rel = "noopener noreferrer";
        source.textContent = "Sumber resmi ↗";
        source.className = "job-source";
        source.style.color = "var(--muted)";
        source.style.fontSize = "13px";

        actions.append(detail, source);

        if (job.apply_url) {
          const apply = document.createElement("a");
          apply.href = job.apply_url;
          apply.target = "_blank";
          apply.rel = "noopener noreferrer";
          apply.textContent = "Lamar ↗";
          apply.className = "btn btn-primary";
          actions.append(apply);
        }

        card.append(company, title, metaRow, description, actions);
        jobList.append(card);
      }
    }

    async function loadJobs() {
      if (!jobStatus) return;

      jobStatus.textContent = "Memuat lowongan...";
      renderSkeletons(PAGE_SIZE);
      if (pagination) pagination.replaceChildren();

      const today = localToday();
      const keyword = (keywordInput?.value || "").trim();
      const province = (provinceInput?.value || "").trim();
      const city = (cityInput?.value || "").trim();
      const district = (districtInput?.value || "").trim();

      let query = supabase
        .from("jobs")
        .select(
          "slug,title,company_name,company_logo,location,province,city,district,employment_type,description,source_url,apply_url,published_at,deadline",
          { count: "exact" }
        )
        .eq("status", "published")
        .gte("deadline", today)
        .order("published_at", { ascending: false })
        .order("slug", { ascending: true });

      if (keyword) {
        const term = escapeLike(keyword).replace(/"/g, '\\"');
        query = query.or(
          `title.ilike."%${term}%",company_name.ilike."%${term}%",location.ilike."%${term}%",description.ilike."%${term}%"`
        );
      }

      if (province) {
        query = query.ilike("province", province);
      }
      if (city) {
        query = query.ilike("location", `%${escapeLike(city)}%`);
      }
      if (district) {
        query = query.ilike("district", district);
      }

      const from = (currentPage - 1) * PAGE_SIZE;
      const to = from + PAGE_SIZE - 1;

      const { data, error, count } = await query.range(from, to);

      if (error) {
        console.error("Gagal memuat lowongan:", error);
        jobStatus.textContent = "Gagal memuat lowongan. Periksa koneksi database.";
        return;
      }

      const total = count || 0;
      const totalPages = Math.ceil(total / PAGE_SIZE);

      if (totalPages > 0 && currentPage > totalPages) {
        currentPage = totalPages;
        window.location.href = makePageUrl(currentPage);
        return;
      }

      if (totalPages === 0) currentPage = 1;

      render((data || []) as Job[], total);
      renderPagination(totalPages);
    }

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      currentPage = 1;
      window.location.href = makePageUrl(1);
    });

    void setupLocationFilters(provinceInput!, cityInput!, districtInput!, {
      province: initialParams.get("provinsi") || "",
      city: initialParams.get("kota") || "",
      district: initialParams.get("kecamatan") || ""
    }).then(() => loadJobs()).catch((error) => {
      console.error("Gagal memuat pilihan wilayah:", error);
      void loadJobs();
    });
  </script></BaseLayout>
