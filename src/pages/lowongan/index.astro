---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
title="Daftar Lowongan Kerja Terbaru | InfoLoker"
description="Cari lowongan kerja berdasarkan posisi, perusahaan, dan lokasi di Indonesia."

>

  <header class="site-header">
    <div class="container navbar">
      <a class="brand" href="/" aria-label="InfoLoker beranda">
        <span class="brand-mark">I</span>
        <span>Info<span>Loker</span></span>
      </a>  <nav class="nav-links" aria-label="Navigasi utama">
    <a href="/">Beranda</a>
    <a href="/lowongan">Lowongan</a>
  </nav>
</div>

  </header>  <main class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <h1>Daftar lowongan kerja</h1>
          <p>Temukan peluang kerja dan periksa sumber rekrutmen resminya.</p>
        </div>
      </div>  <form id="search-form" class="search-panel">
    <div class="search-field">
      <label for="keyword">Posisi atau perusahaan</label>
      <input
        id="keyword"
        type="search"
        placeholder="Contoh: Operator Produksi"
      />
    </div>

    <div class="search-field">
        <label for="province">Provinsi</label>
        <select id="province"><option value="">Memuat provinsi...</option></select>
      </div>
      <div class="search-field">
        <label for="city">Kota/Kabupaten</label>
        <select id="city" disabled><option value="">Pilih provinsi dahulu</option></select>
      </div>
      <div class="search-field">
        <label for="district">Kecamatan</label>
        <select id="district" disabled><option value="">Pilih kota/kabupaten dahulu</option></select>
      </div>

    <button class="btn btn-primary" type="submit">Cari ↗</button>
  </form>

  <p id="job-status" role="status" aria-live="polite">
    Memuat lowongan...
  </p>

  <div id="job-list" class="job-grid"></div>

  <nav id="pagination" aria-label="Navigasi halaman" style="display:flex;justify-content:center;align-items:center;gap:8px;flex-wrap:wrap;margin:28px 0;"></nav>

  <p style="margin-top:32px">
    <a href="/">← Kembali ke beranda</a>
  </p>
</div>

  </main>  <footer class="site-footer">
    <div class="container">
      <div class="footer-bottom">
        © {new Date().getFullYear()} InfoLoker. Periksa informasi melalui sumber resmi.
      </div>
    </div>
  </footer>  <script>
    import { supabase } from "../../lib/supabase";
    import { setupLocationFilters } from "../../scripts/location-filter";

    type Job = {
      slug: string;
      title: string;
      company_name: string;
      company_logo: string | null;
      location: string;
      province: string | null;
      city: string | null;
      district: string | null;
      employment_type: string | null;
      description: string;
      source_url: string;
      apply_url: string | null;
      published_at: string | null;
      deadline: string | null;
    };

    const PAGE_SIZE = 9;
    const form = document.querySelector<HTMLFormElement>("#search-form");
    const keywordInput = document.querySelector<HTMLInputElement>("#keyword");
    const provinceInput = document.querySelector<HTMLSelectElement>("#province");
    const cityInput = document.querySelector<HTMLSelectElement>("#city");
    const districtInput = document.querySelector<HTMLSelectElement>("#district");
    const jobList = document.querySelector<HTMLDivElement>("#job-list");
    const jobStatus = document.querySelector<HTMLParagraphElement>("#job-status");
    const pagination = document.querySelector<HTMLElement>("#pagination");

    const initialParams = new URLSearchParams(window.location.search);
    if (keywordInput) keywordInput.value = initialParams.get("q") || "";


    let currentPage = Math.max(1, Number(initialParams.get("page")) || 1);

    function localToday() {
      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, "0");
      const day = String(now.getDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    }

    function escapeLike(value: string) {
      return value.replace(/[\\%_]/g, "\\$&");
    }

    function makePageUrl(page: number) {
      const params = new URLSearchParams();
      const keyword = (keywordInput?.value || "").trim();
      const province = (provinceInput?.value || "").trim();
      const city = (cityInput?.value || "").trim();
      const district = (districtInput?.value || "").trim();

      if (page > 1) params.set("page", String(page));
      if (keyword) params.set("q", keyword);
      if (province) params.set("provinsi", province);
      if (city) params.set("kota", city);
      if (district) params.set("kecamatan", district);

      const query = params.toString();
      return query ? `/lowongan/?${query}` : "/lowongan/";
    }

    function addPageButton(label: string, page: number, active = false, disabled = false) {
      if (!pagination) return;

      const link = document.createElement("a");
      link.textContent = label;
      link.href = disabled ? "#" : makePageUrl(page);
      link.style.cssText = [
        "display:inline-flex",
        "align-items:center",
        "justify-content:center",
        "min-width:38px",
        "height:38px",
        "padding:0 10px",
        "border:1px solid var(--border, #ddd)",
        "border-radius:8px",
        "text-decoration:none",
        "font-weight:600",
        active ? "background:var(--primary, #2563eb);color:white;border-color:var(--primary, #2563eb)" : "color:inherit",
        disabled ? "opacity:.4;pointer-events:none" : ""
      ].join(";");

      if (active) link.setAttribute("aria-current", "page");
      if (disabled) link.setAttribute("aria-disabled", "true");

      pagination.append(link);
    }

    function renderPagination(totalPages: number) {
      if (!pagination) return;
      pagination.replaceChildren();

      if (totalPages <= 1) return;

      addPageButton("<<", currentPage - 1, false, currentPage === 1);

      const start = Math.max(
        1,
        Math.min(currentPage - 2, totalPages - 4)
      );
      const end = Math.min(totalPages, start + 4);

      for (let page = start; page <= end; page++) {
        addPageButton(String(page), page, page === currentPage);
      }

      addPageButton(">>", currentPage + 1, false, currentPage >= totalPages);
    }

    function render(items: Job[], total: number) {
      if (!jobList || !jobStatus) return;

      jobList.replaceChildren();

      if (!items.length) {
        jobStatus.textContent = "Belum ada lowongan yang sesuai.";
        return;
      }

      jobStatus.textContent =
        `${total} lowongan ditemukan. Halaman ${currentPage}.`;

      for (const job of items) {
        const card = document.createElement("article");
        card.className = "job-card";

        const title = document.createElement("h2");
        title.textContent = job.title;

        const company = document.createElement("div");
        company.className = "job-company";

        const logo = document.createElement("div");
        logo.className = "company-logo";

        const initials = (job.company_name || "PT")
          .split(/\s+/)
          .filter(Boolean)
          .slice(0, 2)
          .map((word) => word[0])
          .join("")
          .toUpperCase();

        if (job.company_logo) {
          const image = document.createElement("img");
          image.src = job.company_logo;
          image.alt = `Logo ${job.company_name}`;
          image.loading = "lazy";
          image.onerror = () => {
            logo.replaceChildren();
            logo.textContent = initials;
          };
          logo.append(image);
        } else {
          logo.textContent = initials;
        }

        const companyName = document.createElement("span");
        companyName.textContent = job.company_name || "Perusahaan tidak diketahui";

        company.append(logo, companyName);

        const location = document.createElement("p");
        location.textContent = `📍 ${job.location}`;

        const type = document.createElement("p");
        type.textContent = job.employment_type || "Jenis pekerjaan tidak dicantumkan";

        const description = document.createElement("p");
        description.textContent = job.description.length > 180
          ? `${job.description.slice(0, 180)}…`
          : job.description;

        const detail = document.createElement("a");
        detail.href = `/lowongan/detail/?slug=${encodeURIComponent(job.slug)}`;
        detail.textContent = "Lihat detail lowongan →";
        detail.className = "job-source";

        const source = document.createElement("a");
        source.href = job.source_url;
        source.target = "_blank";
        source.rel = "noopener noreferrer";
        source.textContent = "Periksa sumber resmi ↗";

        card.append(title, company, location, type, description, detail, source);

        if (job.apply_url) {
          const apply = document.createElement("a");
          apply.href = job.apply_url;
          apply.target = "_blank";
          apply.rel = "noopener noreferrer";
          apply.textContent = "Lamar sekarang";
          apply.className = "btn btn-primary";
          card.append(apply);
        }

        jobList.append(card);
      }
    }

    async function loadJobs() {
      if (!jobStatus) return;

      jobStatus.textContent = "Memuat lowongan...";
      if (pagination) pagination.replaceChildren();

      const today = localToday();
      const keyword = (keywordInput?.value || "").trim();
      const province = (provinceInput?.value || "").trim();
      const city = (cityInput?.value || "").trim();
      const district = (districtInput?.value || "").trim();

      let query = supabase
        .from("jobs")
        .select(
          "slug,title,company_name,company_logo,location,province,city,district,employment_type,description,source_url,apply_url,published_at,deadline",
          { count: "exact" }
        )
        .eq("status", "published")
        .or(`deadline.is.null,deadline.gte.${today}`)
        .order("published_at", { ascending: false })
        .order("slug", { ascending: true });

      if (keyword) {
        const term = escapeLike(keyword).replace(/"/g, '\\"');
        query = query.or(
          `title.ilike."%${term}%",company_name.ilike."%${term}%",location.ilike."%${term}%",description.ilike."%${term}%"`
        );
      }

      if (province) {
        query = query.ilike("province", province);
      }
      if (city) {
        query = query.ilike("location", `%${escapeLike(city)}%`);
      }
      if (district) {
        query = query.ilike("district", district);
      }

      const from = (currentPage - 1) * PAGE_SIZE;
      const to = from + PAGE_SIZE - 1;

      const { data, error, count } = await query.range(from, to);

      if (error) {
        console.error("Gagal memuat lowongan:", error);
        jobStatus.textContent = "Gagal memuat lowongan. Periksa koneksi database.";
        return;
      }

      const total = count || 0;
      const totalPages = Math.ceil(total / PAGE_SIZE);

      if (totalPages > 0 && currentPage > totalPages) {
        currentPage = totalPages;
        window.location.href = makePageUrl(currentPage);
        return;
      }

      if (totalPages === 0) currentPage = 1;

      render((data || []) as Job[], total);
      renderPagination(totalPages);
    }

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      currentPage = 1;
      window.location.href = makePageUrl(1);
    });

    void setupLocationFilters(provinceInput!, cityInput!, districtInput!, {
      province: initialParams.get("provinsi") || "",
      city: initialParams.get("kota") || "",
      district: initialParams.get("kecamatan") || ""
    }).then(() => loadJobs()).catch((error) => {
      console.error("Gagal memuat pilihan wilayah:", error);
      void loadJobs();
    });
  </script></BaseLayout>
