---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Daftar Lowongan Kerja Terbaru | InfoLoker"
  description="Cari lowongan kerja berdasarkan posisi, perusahaan, dan lokasi di Indonesia."
>
  <header class="site-header">
    <div class="container navbar">
      <a class="brand" href="/" aria-label="InfoLoker beranda">
        <span class="brand-mark">I</span>
        <span>Info<span>Loker</span></span>
      </a>
      <nav class="nav-links" aria-label="Navigasi utama">
        <a href="/">Beranda</a>
        <a href="/lowongan">Lowongan</a>
      </nav>
    </div>
  </header>

  <main class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <h1>Daftar lowongan kerja</h1>
          <p>Temukan peluang kerja dan periksa sumber rekrutmen resminya.</p>
        </div>
      </div>

      <form id="search-form" class="search-panel">
        <div class="search-field">
          <label for="keyword">Posisi atau perusahaan</label>
          <input
            id="keyword"
            type="search"
            placeholder="Contoh: Operator Produksi"
          />
        </div>

        <div class="search-field">
          <label for="lokasi">Lokasi kerja</label>
          <select id="lokasi">
            <option value="">Semua lokasi</option>
            <option value="cikarang">Cikarang</option>
            <option value="cibitung">Cibitung</option>
            <option value="bekasi">Bekasi</option>
            <option value="karawang">Karawang</option>
          </select>
        </div>

        <button class="btn btn-primary" type="submit">Cari ↗</button>
      </form>

      <p id="job-status" role="status" aria-live="polite">
        Memuat lowongan...
      </p>

      <div id="job-list" class="job-grid"></div>
      <nav id="pagination" class="pagination" aria-label="Navigasi halaman lowongan"></nav>

      <p style="margin-top:32px">
        <a href="/">← Kembali ke beranda</a>
      </p>
    </div>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-bottom">
        © {new Date().getFullYear()} InfoLoker. Periksa informasi melalui sumber resmi.
      </div>
    </div>
  </footer>

  <script>
    import { supabase } from "../../lib/supabase";

    type Job = {
      slug: string;
      title: string;
      company_name: string;
      location: string;
      employment_type: string | null;
      description: string;
      source_url: string;
      apply_url: string | null;
      published_at: string | null;
      deadline: string | null;
    };

    const PAGE_SIZE = 9;
    const MAX_PAGE_BUTTONS = 5;
    const form = document.querySelector<HTMLFormElement>("#search-form");
    const keywordInput = document.querySelector<HTMLInputElement>("#keyword");
    const locationInput = document.querySelector<HTMLSelectElement>("#lokasi");
    const jobList = document.querySelector<HTMLDivElement>("#job-list");
    const jobStatus = document.querySelector<HTMLParagraphElement>("#job-status");
    const pagination = document.querySelector<HTMLDivElement>("#pagination");

    const state = {
      page: 1,
      keyword: "",
      location: "",
    };

    let totalPages = 1;

    function syncInputValues() {
      if (keywordInput) {
        keywordInput.value = state.keyword;
      }

      if (locationInput) {
        locationInput.value = state.location;
      }
    }

    function readPageState() {
      const params = new URLSearchParams(window.location.search);
      const requestedPage = Number.parseInt(params.get("page") ?? "1", 10);

      state.keyword = (params.get("q") ?? "").trim();
      state.location = (params.get("lokasi") ?? "").trim();
      state.page = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;

      syncInputValues();
    }

    function syncQueryParams() {
      const params = new URLSearchParams(window.location.search);

      if (state.keyword) {
        params.set("q", state.keyword);
      } else {
        params.delete("q");
      }

      if (state.location) {
        params.set("lokasi", state.location);
      } else {
        params.delete("lokasi");
      }

      if (state.page > 1) {
        params.set("page", String(state.page));
      } else {
        params.delete("page");
      }

      const queryString = params.toString();
      const nextUrl = `${window.location.pathname}${queryString ? `?${queryString}` : ""}`;
      window.history.replaceState({}, "", nextUrl);
    }

    function renderJobs(items: Job[]) {
      if (!jobList || !jobStatus) return;

      jobList.replaceChildren();

      if (!items.length) {
        jobStatus.textContent = "Belum ada lowongan yang sesuai.";
        return;
      }

      jobStatus.textContent = `${items.length} lowongan ditampilkan pada halaman ${state.page}.`;

      for (const job of items) {
        const card = document.createElement("article");
        card.className = "job-card";

        const title = document.createElement("h2");
        title.textContent = job.title;

        const company = document.createElement("p");
        company.className = "job-company";
        company.textContent = job.company_name;

        const location = document.createElement("p");
        location.textContent = `📍 ${job.location}`;

        const type = document.createElement("p");
        type.textContent = job.employment_type || "Jenis pekerjaan tidak dicantumkan";

        const description = document.createElement("p");
        description.textContent = job.description.length > 180
          ? `${job.description.slice(0, 180)}…`
          : job.description;

        const detail = document.createElement("a");
        detail.href = `/lowongan/detail/?slug=${encodeURIComponent(job.slug)}`;
        detail.textContent = "Lihat detail lowongan →";
        detail.className = "job-source";

        const source = document.createElement("a");
        source.href = job.source_url;
        source.target = "_blank";
        source.rel = "noopener noreferrer";
        source.textContent = "Periksa sumber resmi ↗";

        card.append(title, company, location, type, description, detail, source);

        if (job.apply_url) {
          const apply = document.createElement("a");
          apply.href = job.apply_url;
          apply.target = "_blank";
          apply.rel = "noopener noreferrer";
          apply.textContent = "Lamar sekarang";
          apply.className = "btn btn-primary";
          card.append(apply);
        }

        jobList.append(card);
      }
    }

    function renderPagination() {
      if (!pagination) return;
      pagination.replaceChildren();

      if (totalPages <= 1) {
        return;
      }

      const previousButton = document.createElement("button");
      previousButton.type = "button";
      previousButton.className = "pagination-btn pagination-btn--nav";
      previousButton.textContent = "Previous";
      previousButton.setAttribute("aria-label", "Halaman sebelumnya");
      previousButton.disabled = state.page <= 1;
      previousButton.addEventListener("click", () => {
        if (state.page <= 1) return;
        state.page -= 1;
        syncQueryParams();
        void loadJobs();
      });
      pagination.append(previousButton);

      let startPage = Math.max(1, state.page - Math.floor(MAX_PAGE_BUTTONS / 2));
      let endPage = Math.min(totalPages, startPage + MAX_PAGE_BUTTONS - 1);

      if (endPage - startPage + 1 < MAX_PAGE_BUTTONS) {
        startPage = Math.max(1, endPage - MAX_PAGE_BUTTONS + 1);
      }

      for (let pageNumber = startPage; pageNumber <= endPage; pageNumber += 1) {
        const pageButton = document.createElement("button");
        pageButton.type = "button";
        pageButton.className = "pagination-btn";
        pageButton.textContent = String(pageNumber);
        pageButton.setAttribute("aria-label", `Halaman ${pageNumber}`);

        if (pageNumber === state.page) {
          pageButton.classList.add("pagination-btn--active");
          pageButton.setAttribute("aria-current", "page");
          pageButton.disabled = true;
        }

        pageButton.addEventListener("click", () => {
          state.page = pageNumber;
          syncQueryParams();
          void loadJobs();
        });

        pagination.append(pageButton);
      }

      const nextButton = document.createElement("button");
      nextButton.type = "button";
      nextButton.className = "pagination-btn pagination-btn--nav";
      nextButton.textContent = "Next";
      nextButton.setAttribute("aria-label", "Halaman berikutnya");
      nextButton.disabled = state.page >= totalPages;
      nextButton.addEventListener("click", () => {
        if (state.page >= totalPages) return;
        state.page += 1;
        syncQueryParams();
        void loadJobs();
      });
      pagination.append(nextButton);
    }

    function createFilteredBaseQuery(today: string) {
      let query = supabase
        .from("jobs")
        .eq("status", "published")
        .or(`deadline.is.null,deadline.gte.${today}`);

      if (state.keyword) {
        const safeKeyword = state.keyword.replace(/[\\%_]/g, "\\$&");
        query = query.or(
          `title.ilike.%${safeKeyword}%,company_name.ilike.%${safeKeyword}%,location.ilike.%${safeKeyword}%,description.ilike.%${safeKeyword}%`
        );
      }

      if (state.location) {
        const safeLocation = state.location.replace(/[\\%_]/g, "\\$&");
        query = query.ilike("location", `%${safeLocation}%`);
      }

      return query;
    }

    async function loadJobs() {
      if (!jobStatus) return;

      readPageState();

      const today = new Date().toISOString().slice(0, 10);
      const { count, error: countError } = await createFilteredBaseQuery(today)
        .select("id", { count: "exact", head: true });

      if (countError) {
        console.error("Gagal menghitung total lowongan:", countError.message);
        jobStatus.textContent = "Gagal memuat lowongan. Periksa koneksi database.";
        return;
      }

      const totalItems = count ?? 0;
      totalPages = totalItems === 0 ? 1 : Math.ceil(totalItems / PAGE_SIZE);

      if (state.page > totalPages) {
        state.page = totalPages;
      }

      if (state.page < 1) {
        state.page = 1;
      }

      syncQueryParams();

      if (totalItems === 0) {
        renderJobs([]);
        renderPagination();
        return;
      }

      const from = (state.page - 1) * PAGE_SIZE;
      const to = from + PAGE_SIZE - 1;

      const { data, error } = await createFilteredBaseQuery(today)
        .select(
          "slug,title,company_name,location,employment_type,description,source_url,apply_url,published_at,deadline"
        )
        .order("published_at", { ascending: false })
        .range(from, to);

      if (error) {
        console.error("Gagal memuat lowongan:", error.message);
        jobStatus.textContent = "Gagal memuat lowongan. Periksa koneksi database.";
        return;
      }

      renderJobs((data || []) as Job[]);
      renderPagination();
    }

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      state.keyword = (keywordInput?.value ?? "").trim();
      state.location = (locationInput?.value ?? "").trim();
      state.page = 1;
      syncQueryParams();
      void loadJobs();
    });

    readPageState();
    void loadJobs();
  </script>
</BaseLayout>
