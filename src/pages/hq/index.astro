      function createRobloxFaceTexture(THREE: any, isCeo: boolean, accentHex: string) {
        const c = document.createElement("canvas");
        c.width = 128;
        c.height = 128;
        const ctx = c.getContext("2d")!;
        ctx.fillStyle = isCeo ? "#ffd66b" : "#ffe08a";
        ctx.fillRect(0, 0, 128, 128);

        // Classic Roblox Eyes
        ctx.fillStyle = "#111827";
        ctx.beginPath();
        ctx.ellipse(42, 52, 7.5, 11, 0, 0, Math.PI * 2);
        ctx.ellipse(86, 52, 7.5, 11, 0, 0, Math.PI * 2);
        ctx.fill();

        // Eye sparkle
        ctx.fillStyle = "#ffffff";
        ctx.beginPath();
        ctx.arc(44, 48, 2.5, 0, Math.PI * 2);
        ctx.arc(88, 48, 2.5, 0, Math.PI * 2);
        ctx.fill();

        // Cool AI Glasses / Visor trim for non-CEO
        if (!isCeo) {
          ctx.strokeStyle = accentHex;
          ctx.lineWidth = 4;
          ctx.strokeRect(24, 38, 36, 28);
          ctx.strokeRect(68, 38, 36, 28);
          ctx.beginPath();
          ctx.moveTo(60, 52);
          ctx.lineTo(68, 52);
          ctx.stroke();
        } else {
          // Executive eyebrows
          ctx.strokeStyle = "#1f2937";
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.moveTo(30, 34);
          ctx.lineTo(52, 37);
          ctx.moveTo(98, 34);
          ctx.lineTo(76, 37);
          ctx.stroke();
        }

        // Classic Roblox Smile
        ctx.strokeStyle = "#111827";
        ctx.lineWidth = 5;
        ctx.lineCap = "round";
        ctx.beginPath();
        ctx.arc(64, 72, 20, 0.2 * Math.PI, 0.8 * Math.PI);
        ctx.stroke();

        const tex = new THREE.CanvasTexture(c);
        tex.colorSpace = THREE.SRGBColorSpace;
        return tex;
      }

      function createLabelSprite(THREE: any, text: string, borderColor: string, isBubble = false) {
        const c = document.createElement("canvas");
        c.width = isBubble ? 512 : 280;
        c.height = isBubble ? 96 : 68;
        const ctx = c.getContext("2d")!;
        ctx.clearRect(0, 0, c.width, c.height);

        const pad = 8;
        const r = isBubble ? 20 : 14;
        const w = c.width - pad * 2;
        const h = c.height - pad * 2;
        ctx.beginPath();
        ctx.roundRect(pad, pad, w, h, r);
        ctx.fillStyle = isBubble ? "rgba(15, 23, 42, 0.94)" : "rgba(8, 13, 24, 0.86)";
        ctx.fill();
        ctx.strokeStyle = borderColor;
        ctx.lineWidth = isBubble ? 4 : 3;
        ctx.stroke();

        ctx.fillStyle = "#f8fafc";
        ctx.font = `700 ${isBubble ? 24 : 24}px 'Plus Jakarta Sans', sans-serif`;
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(text, c.width / 2, c.height / 2 + 1);

        const tex = new THREE.CanvasTexture(c);
        tex.colorSpace = THREE.SRGBColorSpace;
        const mat = new THREE.SpriteMaterial({ map: tex, transparent: true, depthTest: false });
        const sprite = new THREE.Sprite(mat);
        sprite.scale.set(isBubble ? 4.4 : 2.6, isBubble ? 0.82 : 0.64, 1);
        return sprite;
      }

      function createScreenTexture(THREE: any, accentHex: string) {
        const c = document.createElement("canvas");
        c.width = 128;
        c.height = 80;
        const ctx = c.getContext("2d")!;
        ctx.fillStyle = "#040814";
        ctx.fillRect(0, 0, 128, 80);
        ctx.fillStyle = accentHex;
        ctx.fillRect(10, 12, 60, 7);
        ctx.fillStyle = "#38bdf8";
        ctx.fillRect(10, 26, 95, 6);
        ctx.fillStyle = "#22c55e";
        ctx.fillRect(10, 39, 78, 6);
        ctx.fillStyle = "#94a3b8";
        ctx.fillRect(10, 52, 88, 6);
        ctx.fillStyle = accentHex;
        ctx.fillRect(10, 64, 48, 6);
        const tex = new THREE.CanvasTexture(c);
        tex.colorSpace = THREE.SRGBColorSpace;
        return tex;
      }

      function createRobloxCharacter(THREE: any, agent: OfficeAgent, sitting = true) {
        const group = new THREE.Group();
        const skinMat = new THREE.MeshStandardMaterial({
          color: agent.isCeo ? 0xffd66b : 0xffe08a,
          roughness: 0.45,
          metalness: 0.05,
        });
        const faceTex = createRobloxFaceTexture(THREE, Boolean(agent.isCeo), agent.color);
        const faceMat = new THREE.MeshStandardMaterial({ map: faceTex, roughness: 0.45 });

        const torsoMat = new THREE.MeshStandardMaterial({
          color: agent.isCeo ? 0x1e293b : new THREE.Color(agent.color),
          roughness: 0.35,
          metalness: 0.15,
        });
        const pantsMat = new THREE.MeshStandardMaterial({
          color: agent.isCeo ? 0x0f172a : 0x1e293b,
          roughness: 0.6,
        });
        const accentMat = new THREE.MeshStandardMaterial({
          color: new THREE.Color(agent.color),
          emissive: new THREE.Color(agent.color),
          emissiveIntensity: 0.35,
          roughness: 0.3,
        });

        // Torso (Classic Roblox Blocky 1.0 x 1.1 x 0.55)
        const torso = new THREE.Mesh(new THREE.BoxGeometry(1.0, 1.08, 0.54), torsoMat);
        torso.position.y = sitting ? 1.25 : 1.55;
        torso.castShadow = true;
        group.add(torso);

        // Tie / Glowing Core Badge on chest
        const badge = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.52, 0.06), accentMat);
        badge.position.set(0, torso.position.y - 0.04, 0.29);
        group.add(badge);

        // Head (Classic Roblox Rounded Box with face on +Z)
        const headGeo = new THREE.BoxGeometry(0.76, 0.76, 0.76);
        const headMats = [skinMat, skinMat, skinMat, skinMat, faceMat, skinMat];
        const head = new THREE.Mesh(headGeo, headMats);
        head.position.y = torso.position.y + 0.96;
        head.castShadow = true;
        group.add(head);

        // Hair / Cap / CEO Golden Crown
        if (agent.isCeo) {
          const crownMat = new THREE.MeshStandardMaterial({
            color: 0xfbbf24,
            emissive: 0xd97706,
            emissiveIntensity: 0.35,
            metalness: 0.75,
            roughness: 0.2,
          });
          const crownBase = new THREE.Mesh(new THREE.CylinderGeometry(0.42, 0.38, 0.22, 6), crownMat);
          crownBase.position.y = head.position.y + 0.48;
          group.add(crownBase);
          for (let k = 0; k < 5; k++) {
            const ang = (k / 5) * Math.PI * 2;
            const spike = new THREE.Mesh(new THREE.ConeGeometry(0.09, 0.24, 4), crownMat);
            spike.position.set(Math.cos(ang) * 0.3, head.position.y + 0.66, Math.sin(ang) * 0.3);
            group.add(spike);
          }
        } else {
          // Stylish Roblox Hair Block + Tech Antenna
          const hairMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.5 });
          const hair = new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.22, 0.8), hairMat);
          hair.position.y = head.position.y + 0.42;
          group.add(hair);
          const ant = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 0.28, 6), accentMat);
          ant.position.set(0.32, head.position.y + 0.62, 0);
          group.add(ant);
          const orb = new THREE.Mesh(new THREE.SphereGeometry(0.075, 8, 8), accentMat);
          orb.position.set(0.32, head.position.y + 0.78, 0);
          group.add(orb);
        }

        // Jointed Left & Right Arms (Roblox Blocky Arms)
        const armGeo = new THREE.BoxGeometry(0.36, 0.96, 0.38);
        armGeo.translate(0, -0.36, 0);

        const leftArm = new THREE.Mesh(armGeo, torsoMat);
        leftArm.position.set(-0.7, torso.position.y + 0.42, 0);
        leftArm.castShadow = true;
        if (sitting) leftArm.rotation.x = -1.05;
        group.add(leftArm);

        const rightArm = new THREE.Mesh(armGeo, torsoMat);
        rightArm.position.set(0.7, torso.position.y + 0.42, 0);
        rightArm.castShadow = true;
        if (sitting) rightArm.rotation.x = -1.05;
        group.add(rightArm);

        // Blocky Hands
        const handGeo = new THREE.BoxGeometry(0.32, 0.22, 0.32);
        const lHand = new THREE.Mesh(handGeo, skinMat);
        lHand.position.set(0, -0.82, 0);
        leftArm.add(lHand);
        const rHand = new THREE.Mesh(handGeo, skinMat);
        rHand.position.set(0, -0.82, 0);
        rightArm.add(rHand);

        // Gelas Kopi 3D di tangan kanan (muncul saat mode ngopi!)
        const cup = new THREE.Mesh(
          new THREE.CylinderGeometry(0.11, 0.09, 0.22, 8),
          new THREE.MeshStandardMaterial({ color: 0xf8fafc, roughness: 0.3 })
        );
        cup.position.set(0, -0.94, 0.12);
        cup.visible = false;
        rightArm.add(cup);

        // Blocky Legs
        const legGeo = new THREE.BoxGeometry(0.44, 0.98, 0.46);
        legGeo.translate(0, -0.45, 0);

        const leftLeg = new THREE.Mesh(legGeo, pantsMat);
        leftLeg.position.set(-0.26, torso.position.y - 0.54, 0);
        leftLeg.castShadow = true;
        if (sitting) leftLeg.rotation.x = -Math.PI / 2.2;
        group.add(leftLeg);

        const rightLeg = new THREE.Mesh(legGeo, pantsMat);
        rightLeg.position.set(0.26, torso.position.y - 0.54, 0);
        rightLeg.castShadow = true;
        if (sitting) rightLeg.rotation.x = -Math.PI / 2.2;
        group.add(rightLeg);

        return { group, torso, head, leftArm, rightArm, leftLeg, rightLeg, cup };
      }

      async function startAiOfficeAnimation() {
        officeCanvas = document.getElementById("ai-office-canvas") as HTMLCanvasElement | null;
        if (!officeCanvas) return;

        if (clockIntervalId !== null) clearInterval(clockIntervalId);
        const updateClock = () => {
          const el = document.getElementById("office-clock");
          if (!el) return;
          el.textContent = new Intl.DateTimeFormat("id-ID", {
            timeZone: "Asia/Jakarta",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
          }).format(new Date()) + " WIB";
        };
        updateClock();
        clockIntervalId = window.setInterval(updateClock, 1000);

        if (threeReady) return;
        threeReady = true;
        updateInspector(selectedAgentId);

        let THREE: any;
        try {
          const modUrl = "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js";
          THREE = await import(/* @vite-ignore */ modUrl);
        } catch (err) {
          console.error("Gagal memuat Three.js 3D:", err);
          addOfficeFeed("Sistem 3D", "Gagal memuat engine Three.js. Periksa koneksi internet.", "#ef4444");
          threeReady = false;
          return;
        }

        const canvas = officeCanvas;
        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: "high-performance" });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.15;

        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x0b1220);
        scene.fog = new THREE.FogExp2(0x0b1220, 0.011);

        const camera = new THREE.PerspectiveCamera(44, 16 / 9, 0.1, 140);

        // Orbit Camera State — Default: Atas Belakang (nyaman melihat seluruh ruangan kantor)
        let camYaw = 0.0;
        let camPitch = 0.68;
        let camDist = 25.5;
        let targetX = 0;
        let targetZ = -0.6;
        let autoOrbit = false;
        let dragging = false;
        let dragStartX = 0;
        let dragStartY = 0;
        let pointerMoved = false;

        function updateCamera() {
          const x = targetX + camDist * Math.sin(camYaw) * Math.cos(camPitch);
          const y = camDist * Math.sin(camPitch);
          const z = targetZ + camDist * Math.cos(camYaw) * Math.cos(camPitch);
          camera.position.set(x, Math.max(3.8, y), z);
          camera.lookAt(targetX, 1.3, targetZ);
        }

        setCameraPresetFn = (preset) => {
          if (preset === "iso") {
            autoOrbit = false;
            camYaw = 0.0;
            camPitch = 0.68;
            camDist = 25.5;
            targetX = 0;
            targetZ = -0.6;
            document.getElementById("btn-cam-iso")?.classList.add("active");
            document.getElementById("btn-cam-ceo")?.classList.remove("active");
            document.getElementById("btn-cam-orbit")?.classList.remove("active");
          } else if (preset === "ceo") {
            autoOrbit = false;
            camYaw = 0.08;
            camPitch = 0.42;
            camDist = 9.2;
            targetX = 0;
            targetZ = -7.2;
            document.getElementById("btn-cam-iso")?.classList.remove("active");
            document.getElementById("btn-cam-ceo")?.classList.add("active");
            document.getElementById("btn-cam-orbit")?.classList.remove("active");
          } else if (preset === "orbit") {
            autoOrbit = !autoOrbit;
            document.getElementById("btn-cam-orbit")?.classList.toggle("active", autoOrbit);
          }
        };

        // Pencahayaan Kantor Modern (terang, hangat & realistis)
        scene.add(new THREE.HemisphereLight(0xf1f5f9, 0x334155, 1.05));
        const dirLight = new THREE.DirectionalLight(0xfffbeb, 1.35);
        dirLight.position.set(10, 24, 14);
        dirLight.castShadow = true;
        dirLight.shadow.mapSize.set(1024, 1024);
        dirLight.shadow.camera.left = -16;
        dirLight.shadow.camera.right = 16;
        dirLight.shadow.camera.top = 16;
        dirLight.shadow.camera.bottom = -16;
        scene.add(dirLight);

        const officeLight1 = new THREE.PointLight(0xe0f2fe, 0.9, 26);
        officeLight1.position.set(-6, 7.5, 2);
        scene.add(officeLight1);

        const officeLight2 = new THREE.PointLight(0xfef3c7, 0.9, 26);
        officeLight2.position.set(6, 7.5, 2);
        scene.add(officeLight2);

        const ceoSpot = new THREE.PointLight(0xfde68a, 1.1, 16);
        ceoSpot.position.set(0, 6.2, -7.2);
        scene.add(ceoSpot);

        // Tekstur Lantai Kantor Kayu Parket / Ubin Modern
        function createOfficeFloorTexture() {
          const fc = document.createElement("canvas");
          fc.width = 512;
          fc.height = 512;
          const fctx = fc.getContext("2d")!;
          fctx.fillStyle = "#c8b6a0";
          fctx.fillRect(0, 0, 512, 512);
          // Motif papan kayu parket kantor hangat
          const plankH = 32;
          const plankW = 128;
          for (let row = 0; row < 512 / plankH; row++) {
            const offset = (row % 2) * (plankW / 2);
            for (let col = -1; col < 512 / plankW + 1; col++) {
              const shade = 188 + ((row * 17 + col * 31) % 22);
              fctx.fillStyle = `rgb(${shade}, ${shade - 16}, ${shade - 36})`;
              fctx.fillRect(col * plankW + offset + 1, row * plankH + 1, plankW - 2, plankH - 2);
            }
          }
          const tex = new THREE.CanvasTexture(fc);
          tex.wrapS = THREE.RepeatWrapping;
          tex.wrapT = THREE.RepeatWrapping;
          tex.repeat.set(5, 5);
          tex.colorSpace = THREE.SRGBColorSpace;
          return tex;
