---
import "../../styles/global.css";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Headquarters — InfoLokerKita AI Company</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

    <style>
      :root {
        --bg-main: #080b11;
        --bg-card: #0f1623;
        --bg-card-subtle: #141d2e;
        --border-color: #1e293b;
        --border-focus: #38bdf8;
        --text-primary: #f8fafc;
        --text-muted: #94a3b8;
        --accent-blue: #38bdf8;
        --accent-green: #22c55e;
        --accent-lime: #ccff00;
        --accent-orange: #ff5a36;
        --accent-amber: #f59e0b;
        --accent-red: #ef4444;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-main);
        color: var(--text-primary);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
      }

      /* Lock overlay */
      #auth-modal {
        position: fixed;
        inset: 0;
        background: rgba(8, 11, 17, 0.96);
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
      }
      .auth-box {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 32px;
        max-width: 440px;
        width: 100%;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0,0,0,0.6);
      }
      .auth-box h2 { font-size: 1.5rem; margin-bottom: 8px; color: var(--accent-blue); }
      .auth-box p { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 18px; }
      .auth-label {
        display: block;
        text-align: left;
        font-size: 0.78rem;
        color: var(--text-muted);
        margin-bottom: 6px;
      }
      .auth-input {
        width: 100%;
        padding: 12px 16px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        background: var(--bg-main);
        color: #fff;
        font-size: 1.05rem;
        text-align: center;
        letter-spacing: 3px;
        margin-bottom: 14px;
        outline: none;
      }
      .auth-input-url {
        letter-spacing: normal;
        text-align: left;
        font-size: 0.85rem;
        font-family: 'JetBrains Mono', monospace;
      }
      .auth-input:focus { border-color: var(--accent-blue); }
      .auth-btn {
        width: 100%;
        padding: 12px;
        border-radius: 8px;
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: #fff;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: opacity 0.2s;
      }
      .auth-btn:hover { opacity: 0.9; }
      .auth-btn:disabled { opacity: 0.6; cursor: wait; }

      /* Command Center Layout */
      .app-layout {
        display: flex;
        min-height: 100vh;
      }
      .app-layout[hidden] {
        display: none;
      }

      /* Sidebar */
      .sidebar {
        width: 270px;
        background: var(--bg-card);
        border-right: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        transition: transform 0.3s ease;
      }
      .sidebar-header {
        padding: 20px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .sidebar-brand { font-size: 1.1rem; font-weight: 800; color: #fff; }
      .sidebar-brand span { color: var(--accent-blue); }
      .sidebar-nav {
        flex: 1;
        padding: 16px 12px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .nav-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        border-radius: 8px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        background: transparent;
        border: none;
        cursor: pointer;
        width: 100%;
        text-align: left;
        transition: all 0.2s;
      }
      .nav-btn:hover { background: var(--bg-card-subtle); color: #fff; }
      .nav-btn.active {
        background: rgba(56, 189, 248, 0.12);
        color: var(--accent-blue);
        border-left: 3px solid var(--accent-blue);
      }
      .sidebar-footer {
        padding: 16px;
        border-top: 1px solid var(--border-color);
        font-size: 0.8rem;
        color: var(--text-muted);
      }

      /* Main Content */
      .main-viewport {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        background: radial-gradient(circle at top right, #111a2e 0%, #080b11 60%);
      }

      /* Top Header */
      .top-navbar {
        height: 64px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        background: rgba(15, 22, 35, 0.85);
        backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
        z-index: 50;
      }
      .header-title-box { display: flex; align-items: center; gap: 12px; }
      .menu-toggle-btn {
        display: none;
        background: none;
        border: none;
        color: #fff;
        font-size: 1.4rem;
        cursor: pointer;
      }
      .badge-ceo {
        background: rgba(255, 90, 54, 0.15);
        border: 1px solid var(--accent-orange);
        color: var(--accent-orange);
        padding: 4px 10px;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.5px;
      }
      .header-actions { display: flex; align-items: center; gap: 12px; }
      .btn-action-sm {
        padding: 8px 14px;
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid var(--border-color);
        background: var(--bg-card-subtle);
        color: #fff;
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .btn-action-sm:hover { border-color: var(--accent-blue); }
      .btn-action-primary {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        border: none;
      }

      /* Content Area */
      .content-body {
        padding: 24px;
        flex: 1;
        overflow-y: auto;
      }

      .tab-section { display: none; }
      .tab-section.active { display: block; }

      /* Cards & Grids */
      .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
      }
      .stat-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 20px;
        position: relative;
        overflow: hidden;
      }
      .stat-card::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; height: 3px;
        background: var(--accent-blue);
      }
      .stat-card.green::after { background: var(--accent-green); }
      .stat-card.orange::after { background: var(--accent-orange); }
      .stat-card.amber::after { background: var(--accent-amber); }
      .stat-val { font-size: 1.8rem; font-weight: 800; margin: 8px 0 4px; color: #fff; font-family: 'JetBrains Mono', monospace; }
      .stat-label { font-size: 0.85rem; color: var(--text-muted); }

      .card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
      }
      .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-color);
      }
      .card-title { font-size: 1.15rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 8px; }

      /* Command input box */
      .ceo-command-bar {
        display: flex;
        gap: 12px;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        padding: 12px;
        border-radius: 12px;
        margin-bottom: 24px;
      }
      .ceo-command-bar input {
        flex: 1;
        background: transparent;
        border: none;
        color: #fff;
        font-size: 0.95rem;
        outline: none;
      }
      .ceo-command-bar button {
        background: var(--accent-blue);
        color: #080b11;
        font-weight: 700;
        border: none;
        padding: 8px 20px;
        border-radius: 8px;
        cursor: pointer;
      }

      /* Tables */
      .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
      }
      .data-table th, .data-table td {
        padding: 12px 14px;
        text-align: left;
        border-bottom: 1px solid var(--border-color);
      }
      .data-table th {
        color: var(--text-muted);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
      }
      .data-table tr:hover { background: rgba(255,255,255,0.02); }

      .badge-status {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
      }
      .badge-status.completed { background: rgba(34, 197, 94, 0.15); color: var(--accent-green); }
      .badge-status.running { background: rgba(56, 189, 248, 0.15); color: var(--accent-blue); }
      .badge-status.pending { background: rgba(245, 158, 11, 0.15); color: var(--accent-amber); }
      .badge-status.failed { background: rgba(239, 68, 68, 0.15); color: var(--accent-red); }
      .badge-status.needs_approval { background: rgba(255, 90, 54, 0.2); color: var(--accent-orange); }

      pre.log-box {
        background: #05070c;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 14px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #a5b4fc;
        max-height: 260px;
        overflow-y: auto;
        white-space: pre-wrap;
      }

      /* Mobile responsiveness */
      @media (max-width: 900px) {
        .sidebar {
          position: fixed;
          top: 0; bottom: 0; left: 0;
          z-index: 99;
          transform: translateX(-100%);
        }
        .sidebar.open { transform: translateX(0); }
        .menu-toggle-btn { display: block; }
      }
    </style>
  </head>
  <body>

    <!-- CEO PIN Gate (diverifikasi langsung ke API backend AI Company) -->
    <div id="auth-modal">
      <div class="auth-box">
        <div style="font-size: 2.5rem; margin-bottom: 12px;">🛡️</div>
        <h2>InfoLokerKita AI Headquarters</h2>
        <p>Akses Terbatas: PIN CEO diverifikasi langsung melalui server API AI Company.</p>
        <label class="auth-label" for="api-base-input">Alamat Server API AI Company</label>
        <input type="url" id="api-base-input" class="auth-input auth-input-url" value="http://127.0.0.1:8787" />
        <label class="auth-label" for="ceo-pin-input">PIN Otorisasi CEO</label>
        <input type="password" id="ceo-pin-input" class="auth-input" placeholder="••••••••" autocomplete="current-password" autofocus />
        <button id="ceo-pin-submit" class="auth-btn" type="button">Verifikasi & Buka Pusat Kendali</button>
        <p id="auth-err" style="color: var(--accent-red); font-size: 0.82rem; margin-top: 12px; margin-bottom: 0; display: none;"></p>
      </div>
    </div>

    <div class="app-layout" id="hq-app" hidden>
      <!-- Sidebar Navigation -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
          <img src="/favicon.svg" alt="Logo" width="28" height="28" />
          <div class="sidebar-brand">AI <span>HQ</span></div>
        </div>
        <nav class="sidebar-nav">
          <button class="nav-btn active" data-tab="overview">📊 1. Overview</button>
          <button class="nav-btn" data-tab="employees">🤖 2. AI Employees</button>
          <button class="nav-btn" data-tab="recruitment">💼 3. Recruitment Dept</button>
          <button class="nav-btn" data-tab="newsroom">📰 4. Newsroom Dept</button>
          <button class="nav-btn" data-tab="seo">🔍 5. SEO Department</button>
          <button class="nav-btn" data-tab="design">🎨 6. Design Department</button>
          <button class="nav-btn" data-tab="data">🗄️ 7. Data Management</button>
          <button class="nav-btn" data-tab="marketing">📢 8. Marketing Dept</button>
          <button class="nav-btn" data-tab="auditor">🛡️ 9. AI Auditor</button>
          <button class="nav-btn" data-tab="tasks">📋 10. Task Management</button>
          <button class="nav-btn" data-tab="automation">⚡ 11. Automation Center</button>
          <button class="nav-btn" data-tab="financial">💰 12. Financial Reports</button>
          <button class="nav-btn" data-tab="settings">⚙️ 13. System Settings</button>
        </nav>
        <div class="sidebar-footer">
          <div>Website: <a href="/" target="_blank" rel="noopener noreferrer" style="color: var(--accent-blue); text-decoration: none;">infolokerkita.web.id ↗</a></div>
          <div style="margin-top: 4px;">Portal: <a href="/lowongan/" target="_blank" rel="noopener noreferrer" style="color: var(--accent-blue); text-decoration: none;">Lowongan</a> · <a href="/berita/" target="_blank" rel="noopener noreferrer" style="color: var(--accent-blue); text-decoration: none;">Berita</a></div>
        </div>
      </aside>

      <!-- Main Viewport -->
      <div class="main-viewport">
        <!-- Top Navbar -->
        <header class="top-navbar">
          <div class="header-title-box">
            <button class="menu-toggle-btn" id="menu-toggle" aria-label="Toggle menu">☰</button>
            <h1 id="page-title" style="font-size: 1.15rem; font-weight: 700;">Command Center Overview</h1>
            <span class="badge-ceo">● CEO HUMAN FOUNDER</span>
          </div>
          <div class="header-actions">
            <button class="btn-action-sm btn-action-primary" id="btn-quick-report">📄 Laporan Harian</button>
            <button class="btn-action-sm" id="btn-logout" title="Kunci Dashboard">🔒 Kunci</button>
          </div>
        </header>

        <!-- Main Content Area -->
        <main class="content-body">

          <!-- 1. OVERVIEW TAB -->
          <section id="tab-overview" class="tab-section active">
            <div class="ceo-command-bar">
              <span style="font-size: 1.2rem; align-self: center;">💬</span>
              <input type="text" id="ceo-command-input" placeholder="Ketik perintah untuk AI Manager (contoh: 'Cari 10 loker baru', 'Buat artikel berita', 'Arsipkan loker expired', 'Audit sistem')..." />
              <button id="btn-send-ceo-command">Kirim ke AI Manager</button>
            </div>

            <div class="stat-grid">
              <div class="stat-card">
                <div class="stat-label">Total Lowongan Aktif (WIB)</div>
                <div class="stat-val" id="stat-jobs-count">...</div>
                <div style="font-size: 0.78rem; color: var(--accent-blue);">Status published & belum kedaluwarsa</div>
              </div>
              <div class="stat-card green">
                <div class="stat-label">Total Berita Terbit (Supabase)</div>
                <div class="stat-val" id="stat-news-count">...</div>
                <div style="font-size: 0.78rem; color: var(--accent-green);">Status published & terverifikasi</div>
              </div>
              <div class="stat-card orange">
                <div class="stat-label">Divisi AI Aktif</div>
                <div class="stat-val" id="stat-agents-count">...</div>
                <div style="font-size: 0.78rem; color: var(--accent-orange);">AI Manager + Divisi Operasional</div>
              </div>
              <div class="stat-card amber">
                <div class="stat-label">Status Server AI API</div>
                <div class="stat-val" id="stat-system-status" style="font-size: 1.2rem; color: var(--accent-amber);">MEMERIKSA...</div>
                <div style="font-size: 0.78rem; color: var(--text-muted);">Astro + Cloudflare + Supabase</div>
              </div>
            </div>

            <div class="card">
              <div class="card-header">
                <div class="card-title">🤖 Briefing AI Manager (Direktur Operasional)</div>
                <span style="font-size: 0.8rem; color: var(--text-muted);" id="manager-time">Memuat waktu WIB...</span>
              </div>
              <p style="font-size: 0.92rem; line-height: 1.6; color: #cbd5e1;" id="manager-briefing-text">
                Memuat ringkasan operasional terbaru dari database Supabase dan server AI Company...
              </p>
            </div>

            <div class="card">
              <div class="card-header">
                <div class="card-title">📋 Aktivitas Tugas Terbaru Antar-Divisi</div>
                <button class="btn-action-sm" id="btn-refresh-tasks">Segarkan</button>
              </div>
              <div style="overflow-x: auto;">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Task ID</th>
                      <th>Divisi AI</th>
                      <th>Deskripsi Tugas</th>
                      <th>Status</th>
                      <th>Waktu</th>
                    </tr>
                  </thead>
                  <tbody id="overview-tasks-tbody">
                    <tr><td colspan="5" style="text-align: center; color: var(--text-muted);">Memuat riwayat tugas...</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <!-- 2. AI EMPLOYEES TAB -->
          <section id="tab-employees" class="tab-section">
            <div class="card">
              <div class="card-header">
                <div class="card-title">👥 Struktur Organisasi & Divisi AI</div>
              </div>
              <div class="stat-grid" id="agents-card-grid"></div>
            </div>
          </section>

          <!-- 3. RECRUITMENT DEPT TAB -->
          <section id="tab-recruitment" class="tab-section">
            <div class="card">
              <div class="card-header">
                <div class="card-title">💼 AI Recruitment — Kendali Scraper & Kurasi Loker</div>
                <button class="btn-action-sm btn-action-primary" id="btn-trigger-recruitment">⚡ Jalankan Pencarian Loker</button>
              </div>
              <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 16px;">
                AI Recruitment memindai portal Karirhub Kemnaker dan sumber resmi, memetakan wilayah WIB, dan menyaring perusahaan terpercaya di Indonesia.
              </p>
              <div id="recruitment-result-box" style="margin-top: 12px;"></div>
            </div>
          </section>

          <!-- 4. NEWSROOM DEPT TAB -->
          <section id="tab-newsroom" class="tab-section">
            <div class="card">
              <div class="card-header">
                <div class="card-title">📰 AI Newsroom — Riset & Publikasi Berita Industri</div>
                <button class="btn-action-sm btn-action-primary" id="btn-trigger-newsroom">⚡ Buat 1 Artikel Berita Baru</button>
              </div>
              <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 16px;">
                Memantau feed berita primer (ANTARA News, Kemnaker), menyusun draf faktual tanpa halusinasi, dan mempublikasikan ke Supabase.
              </p>
              <div id="newsroom-result-box"></div>
            </div>
          </section>

          <!-- 5. SEO TAB -->
          <section id="tab-seo" class="tab-section">
            <div class="card">
              <div class="card-header">
                <div class="card-title">🔍 AI SEO Specialist — Optimasi Metadata & Sitemap</div>
              </div>
              <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 16px;">
                Standar SEO InfoLokerKita: URL kanonis konsisten, <code>JobPosting</code> & <code>NewsArticle</code> JSON-LD, serta <code>sitemap.xml</code> tersinkronisasi dengan zona waktu WIB.
              </p>
              <div class="stat-grid">
                <div class="stat-card"><div class="stat-label">Sitemap XML</div><div class="stat-val" style="font-size: 1rem;"><a href="/sitemap.xml" target="_blank" rel="noopener noreferrer" style="color: var(--accent-blue); text-decoration: none;">/sitemap.xml ↗</a></div></div>
                <div class="stat-card"><div class="stat-label">Robots.txt</div><div class="stat-val" style="font-size: 1rem;"><a href="/robots.txt" target="_blank" rel="noopener noreferrer" style="color: var(--accent-green); text-decoration: none;">/robots.txt ↗</a></div></div>
                <div class="stat-card"><div class="stat-label">Rute Detail Loker</div><div class="stat-val" style="font-size: 1rem; color: var(--accent-lime);">/lowongan/[slug]/</div></div>
              </div>
            </div>
          </section>

          <!-- 6. DESIGN TAB -->
          <section id="tab-design" class="tab-section">
            <div class="card">
              <div class="card-header">
                <div class="card-title">🎨 AI Designer — Logo Resmi & Generator Thumbnail 16:9</div>
              </div>
              <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 16px;">
                Semua artikel berita otomatis dilengkapi thumbnail 16:9 orisinal di <code>public/images/berita/</code> dengan branding InfoLokerKita.
              </p>
            </div>
          </section>

          <!-- 7. DATA MANAGEMENT TAB -->
          <section id="tab-data" class="tab-section">
            <div class="card">
              <div class="card-header">
                <div class="card-title">🗄️ AI Data Manager — Penjelajah Database Supabase</div>
                <button class="btn-action-sm" id="btn-cleanup-expired">🧹 Arsipkan Loker Expired</button>
              </div>
              <div id="cleanup-result-box" style="margin-bottom: 12px;"></div>
              <div style="overflow-x: auto; margin-top: 12px;">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Judul Lowongan</th>
                      <th>Perusahaan</th>
                      <th>Lokasi</th>
                      <th>Batas Lamaran</th>
                      <th>Aksi</th>
                    </tr>
                  </thead>
                  <tbody id="supabase-jobs-tbody">
                    <tr><td colspan="5" style="text-align: center; color: var(--text-muted);">Memuat data dari Supabase...</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <!-- 8. MARKETING TAB -->
          <section id="tab-marketing" class="tab-section">
            <div class="card">
              <div class="card-header">
                <div class="card-title">📢 AI Marketing — Kalender Konten & Salinan Promosi</div>
                <button class="btn-action-sm btn-action-primary" id="btn-generate-calendar">⚡ Buat Kalender Promosi Hari Ini</button>
              </div>
              <div id="marketing-calendar-box" style="margin-top: 16px;"></div>
            </div>
          </section>

          <!-- 9. AUDITOR TAB -->
          <section id="tab-auditor" class="tab-section">
            <div class="card">
              <div class="card-header">
                <div class="card-title">🛡️ AI Auditor — Inspeksi Kesehatan & Integritas Sistem</div>
                <button class="btn-action-sm btn-action-primary" id="btn-run-audit-now">⚡ Jalankan Audit Sekarang</button>
              </div>
              <div id="audit-results-box" style="margin-top: 16px;"></div>
            </div>
          </section>

          <!-- 10. TASK MANAGEMENT TAB -->
          <section id="tab-tasks" class="tab-section">
            <div class="card">
              <div class="card-header">
                <div class="card-title">📋 Task Management — Antrean Koordinasi Antar-Agent</div>
              </div>
              <div style="overflow-x: auto;">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Task ID</th>
                      <th>Divisi</th>
                      <th>Judul</th>
                      <th>Status</th>
                      <th>Waktu Selesai</th>
                    </tr>
                  </thead>
                  <tbody id="full-tasks-tbody">
                    <tr><td colspan="5" style="text-align: center; color: var(--text-muted);">Memuat antrean tugas...</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <!-- 11. AUTOMATION CENTER TAB -->
          <section id="tab-automation" class="tab-section">
            <div class="card">
              <div class="card-header">
                <div class="card-title">⚡ Automation Center — Penjadwalan Operasional AI</div>
              </div>
              <div class="stat-grid">
                <div class="stat-card">
                  <div class="stat-label">Siklus Pagi (05.00 WIB)</div>
                  <div style="font-weight: 700; margin: 6px 0;">Kurasi Loker</div>
                  <button class="btn-action-sm" data-cycle="0500">Jalankan 05.00</button>
                </div>
                <div class="stat-card green">
                  <div class="stat-label">Siklus Pagi (07.00 WIB)</div>
                  <div style="font-weight: 700; margin: 6px 0;">Redaksi Berita</div>
                  <button class="btn-action-sm" data-cycle="0700">Jalankan 07.00</button>
                </div>
                <div class="stat-card orange">
                  <div class="stat-label">Siklus Pagi (08.00 WIB)</div>
                  <div style="font-weight: 700; margin: 6px 0;">Audit & Laporan</div>
                  <button class="btn-action-sm" data-cycle="0800">Jalankan 08.00</button>
                </div>
              </div>
            </div>
          </section>

          <!-- 12. FINANCIAL REPORTS TAB -->
          <section id="tab-financial" class="tab-section">
            <div class="card">
              <div class="card-header">
                <div class="card-title">💰 Financial Reports — Saluran Pendapatan Perusahaan</div>
              </div>
              <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 16px;">
                Prinsip InfoLokerKita: Pendapatan hanya dicatat apabila ada transaksi nyata yang terverifikasi.
              </p>
              <div class="stat-grid">
                <div class="stat-card"><div class="stat-label">Google AdSense</div><div class="stat-val" style="font-size: 1.2rem; color: var(--accent-green);">Rp 0 (Siap Setup)</div></div>
                <div class="stat-card"><div class="stat-label">Sponsored Vacancies</div><div class="stat-val" style="font-size: 1.2rem; color: var(--accent-blue);">Rp 0</div></div>
                <div class="stat-card"><div class="stat-label">Sponsored Articles</div><div class="stat-val" style="font-size: 1.2rem; color: var(--accent-lime);">Rp 0</div></div>
              </div>
            </div>
          </section>

          <!-- 13. SYSTEM SETTINGS TAB -->
          <section id="tab-settings" class="tab-section">
            <div class="card">
              <div class="card-header">
                <div class="card-title">⚙️ System Settings — Konfigurasi & Keamanan</div>
              </div>
              <div style="display: flex; flex-direction: column; gap: 14px; max-width: 600px;">
                <div>
                  <label style="font-size: 0.85rem; color: var(--text-muted); display: block; margin-bottom: 4px;">Alamat API AI Company Aktif</label>
                  <input type="text" id="cfg-api-base" readonly style="width: 100%; padding: 10px; background: #05070c; border: 1px solid var(--border-color); color: #fff; border-radius: 6px;" />
                </div>
                <div>
                  <label style="font-size: 0.85rem; color: var(--text-muted); display: block; margin-bottom: 4px;">Supabase Project URL</label>
                  <input type="text" id="cfg-supabase-url" readonly style="width: 100%; padding: 10px; background: #05070c; border: 1px solid var(--border-color); color: #fff; border-radius: 6px;" value="Terkonfigurasi via .env" />
                </div>
                <div>
                  <label style="font-size: 0.85rem; color: var(--text-muted); display: block; margin-bottom: 4px;">AI Model Engine</label>
                  <input type="text" id="cfg-ai-model" readonly style="width: 100%; padding: 10px; background: #05070c; border: 1px solid var(--border-color); color: #fff; border-radius: 6px;" value="Google Gemini (gemini-2.5-flash) / Heuristic Fallback" />
                </div>
              </div>
            </div>
          </section>

        </main>
      </div>
    </div>

    <!-- Interactive Client Script -->
    <script>
      import { supabase } from "../../lib/supabase";
      import { formatJakartaDate, getJakartaToday, getJobDetailPath } from "../../lib/seo";

      const DEFAULT_API_BASE = "http://127.0.0.1:8787";
      let activeApiBase = (sessionStorage.getItem("hq_api_base") || DEFAULT_API_BASE).replace(/\/+$/, "");
      let ceoPin = sessionStorage.getItem("ceo_pin") || "";

      const authModal = document.getElementById("auth-modal");
      const hqApp = document.getElementById("hq-app");
      const apiBaseInput = document.getElementById("api-base-input") as HTMLInputElement | null;
      const pinInput = document.getElementById("ceo-pin-input") as HTMLInputElement | null;
      const pinSubmit = document.getElementById("ceo-pin-submit") as HTMLButtonElement | null;
      const authErr = document.getElementById("auth-err");

      if (apiBaseInput) {
        apiBaseInput.value = activeApiBase;
      }

      function escapeHtml(s: unknown): string {
        return String(s ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      function showAuthError(message: string) {
        if (!authErr) return;
        authErr.textContent = message;
        authErr.style.display = "block";
      }

      function clearAuthError() {
        if (!authErr) return;
        authErr.textContent = "";
        authErr.style.display = "none";
      }

      function lockDashboard(reason?: string) {
        sessionStorage.removeItem("ceo_pin");
        ceoPin = "";
        if (hqApp) hqApp.hidden = true;
        if (authModal) authModal.style.display = "flex";
        if (reason) showAuthError(reason);
      }

      async function apiFetch(path: string, options: RequestInit = {}) {
        const headers = new Headers(options.headers || {});
        headers.set("X-CEO-PIN", ceoPin);
        if (options.body && !headers.has("Content-Type")) {
          headers.set("Content-Type", "application/json");
        }
        const resp = await fetch(`${activeApiBase}${path}`, {
          ...options,
          headers,
        });
        if (resp.status === 401) {
          lockDashboard("Sesi otorisasi ditolak atau kedaluwarsa. Masukkan PIN CEO yang valid.");
          throw new Error("Unauthorized");
        }
        return resp;
      }

      async function verifyAndUnlock(pin: string, apiBase: string): Promise<boolean> {
        const normalizedBase = apiBase.trim().replace(/\/+$/, "");
        if (!normalizedBase) {
          showAuthError("Alamat server API AI Company tidak boleh kosong.");
          return false;
        }
        if (!pin) {
          showAuthError("Masukkan PIN CEO terlebih dahulu.");
          return false;
        }

        try {
          const resp = await fetch(`${normalizedBase}/api/auth/verify`, {
            method: "GET",
            headers: { "X-CEO-PIN": pin },
          });

          if (resp.ok) {
            activeApiBase = normalizedBase;
            ceoPin = pin;
            sessionStorage.setItem("hq_api_base", activeApiBase);
            sessionStorage.setItem("ceo_pin", ceoPin);
            clearAuthError();
            if (authModal) authModal.style.display = "none";
            if (hqApp) hqApp.hidden = false;
            const cfgApi = document.getElementById("cfg-api-base") as HTMLInputElement | null;
            if (cfgApi) cfgApi.value = activeApiBase;
            void initDashboard();
            return true;
          }

          if (resp.status === 401) {
            showAuthError("PIN CEO tidak valid. Akses ditolak oleh server.");
          } else if (resp.status === 503) {
            showAuthError("Server belum mengonfigurasi CEO_SECRET_PIN di environment/.env.");
          } else if (resp.status === 403) {
            showAuthError("Origin situs ini belum masuk daftar AI_COMPANY_ALLOWED_ORIGINS di server.");
          } else {
            showAuthError(`Verifikasi gagal (HTTP ${resp.status}).`);
          }
          return false;
        } catch {
          showAuthError(
            "Tidak dapat terhubung ke server AI Company. Jalankan: python -m automation.ai_company.cli server"
          );
          return false;
        }
      }

      pinSubmit?.addEventListener("click", async () => {
        if (!pinSubmit || !pinInput) return;
        const val = pinInput.value.trim();
        const apiBase = apiBaseInput?.value.trim() || DEFAULT_API_BASE;
        pinSubmit.disabled = true;
        pinSubmit.textContent = "Memverifikasi...";
        try {
          await verifyAndUnlock(val, apiBase);
        } finally {
          pinSubmit.disabled = false;
          pinSubmit.textContent = "Verifikasi & Buka Pusat Kendali";
        }
      });

      pinInput?.addEventListener("keyup", (e) => {
        if (e.key === "Enter") pinSubmit?.click();
      });

      document.getElementById("btn-logout")?.addEventListener("click", () => {
        lockDashboard();
      });

      // Navigation tab switching
      const navButtons = document.querySelectorAll(".nav-btn");
      const tabSections = document.querySelectorAll(".tab-section");
      const pageTitle = document.getElementById("page-title");

      navButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          navButtons.forEach((b) => b.classList.remove("active"));
          tabSections.forEach((s) => s.classList.remove("active"));

          btn.classList.add("active");
          const tabId = btn.getAttribute("data-tab");
          const targetSection = document.getElementById(`tab-${tabId}`);
          if (targetSection) targetSection.classList.add("active");

          if (pageTitle) pageTitle.textContent = btn.textContent?.replace(/^[^\s]+\s+/, "") || "Command Center";
          document.getElementById("sidebar")?.classList.remove("open");
        });
      });

      document.getElementById("menu-toggle")?.addEventListener("click", () => {
        document.getElementById("sidebar")?.classList.toggle("open");
      });

      async function initDashboard() {
        const managerTime = document.getElementById("manager-time");
        if (managerTime) {
          managerTime.textContent = `${formatJakartaDate(new Date().toISOString())} (WIB)`;
        }
        await Promise.all([
          loadSupabaseStats(),
          loadApiStatus(),
          loadRecentTasks(),
        ]);
      }

      async function loadSupabaseStats() {
        const todayWib = getJakartaToday();
        try {
          const [jobsRes, newsRes, recentRes] = await Promise.all([
            supabase
              .from("jobs")
              .select("id", { count: "exact", head: true })
              .eq("status", "published")
              .not("deadline", "is", null)
              .gte("deadline", todayWib),
            supabase
              .from("news")
              .select("id", { count: "exact", head: true })
              .eq("status", "published"),
            supabase
              .from("jobs")
              .select("title,company_name,location,deadline,slug")
              .eq("status", "published")
              .not("deadline", "is", null)
              .gte("deadline", todayWib)
              .order("published_at", { ascending: false })
              .limit(8),
          ]);

          const activeJobs = jobsRes.count || 0;
          const publishedNews = newsRes.count || 0;

          const jobsEl = document.getElementById("stat-jobs-count");
          const newsEl = document.getElementById("stat-news-count");
          if (jobsEl) jobsEl.textContent = String(activeJobs);
          if (newsEl) newsEl.textContent = String(publishedNews);

          const briefingEl = document.getElementById("manager-briefing-text");
          if (briefingEl) {
            briefingEl.textContent =
              `Selamat datang, CEO. Database Supabase saat ini mencatat ${activeJobs} lowongan kerja aktif (batas pendaftaran >= ${todayWib} WIB) dan ${publishedNews} artikel berita terbit. Jadwal otomatis berjalan pada 05.00, 05.30, 07.00, dan 08.00 WIB.`;
          }

          const tbody = document.getElementById("supabase-jobs-tbody");
          const recentJobs = recentRes.data || [];
          if (tbody) {
            if (!recentJobs.length) {
              tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: var(--text-muted);">Belum ada lowongan aktif saat ini.</td></tr>';
            } else {
              tbody.innerHTML = recentJobs.map((j) => `
                <tr>
                  <td><strong>${escapeHtml(j.title)}</strong></td>
                  <td>${escapeHtml(j.company_name)}</td>
                  <td>${escapeHtml(j.location)}</td>
                  <td>${escapeHtml(j.deadline ? formatJakartaDate(j.deadline) : "Tidak dibatasi")}</td>
                  <td><a href="${getJobDetailPath(j.slug)}" target="_blank" rel="noopener noreferrer" style="color: var(--accent-blue); text-decoration: none;">Lihat ↗</a></td>
                </tr>
              `).join("");
            }
          }
        } catch (e) {
          console.error("Gagal memuat statistik Supabase:", e);
        }
      }

      async function loadApiStatus() {
        const statusEl = document.getElementById("stat-system-status");
        const agentsEl = document.getElementById("stat-agents-count");

        try {
          const resp = await apiFetch("/api/status");
          if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
          const data = await resp.json();
          const metrics = data.metrics || {};

          if (statusEl) {
            statusEl.textContent = "🟢 ONLINE";
            statusEl.style.color = "var(--accent-green)";
          }
          if (agentsEl) {
            const activeCount = metrics.active_agents_count ?? 0;
            const totalCount = metrics.total_agents_count ?? (data.agents?.length || 0);
            agentsEl.textContent = `${activeCount} / ${totalCount}`;
          }
          if (Array.isArray(data.agents)) {
            renderOrgChart(data.agents);
          }
        } catch {
          if (statusEl) {
            statusEl.textContent = "🔴 OFFLINE";
            statusEl.style.color = "var(--accent-red)";
          }
          if (agentsEl) agentsEl.textContent = "—";
        }
      }

      async function loadRecentTasks() {
        try {
          const resp = await apiFetch("/api/tasks");
          if (resp.ok) {
            const data = await resp.json();
            renderTaskRows(data.tasks || []);
          } else {
            renderTaskError("Gagal memuat daftar tugas dari server API.");
          }
        } catch {
          renderTaskError("Server API tidak terjangkau.");
        }
      }

      function renderTaskError(msg: string) {
        const row = `<tr><td colspan="5" style="text-align: center; color: var(--text-muted);">${escapeHtml(msg)}</td></tr>`;
        const tbody = document.getElementById("overview-tasks-tbody");
        const fullTbody = document.getElementById("full-tasks-tbody");
        if (tbody) tbody.innerHTML = row;
        if (fullTbody) fullTbody.innerHTML = row;
      }

      function renderTaskRows(tasks: any[]) {
        const tbody = document.getElementById("overview-tasks-tbody");
        const fullTbody = document.getElementById("full-tasks-tbody");
        const rows = tasks.slice(0, 15).map((t) => {
          const safeStatus = escapeHtml(String(t.status || "pending").toLowerCase());
          const timeLabel = t.completed_at
            ? formatJakartaDate(t.completed_at, { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" })
            : "-";
          return `
            <tr>
              <td><code>${escapeHtml(t.task_id)}</code></td>
              <td><strong>${escapeHtml(t.agent_name)}</strong></td>
              <td>${escapeHtml(t.title)}</td>
              <td><span class="badge-status ${safeStatus}">${escapeHtml(String(t.status || "").toUpperCase())}</span></td>
              <td>${escapeHtml(timeLabel)}</td>
            </tr>
          `;
        }).join("");

        const emptyRow = '<tr><td colspan="5" style="text-align: center; color: var(--text-muted);">Belum ada tugas tercatat.</td></tr>';
        if (tbody) tbody.innerHTML = rows || emptyRow;
        if (fullTbody) fullTbody.innerHTML = rows || emptyRow;
      }

      function renderOrgChart(agents: any[]) {
        const container = document.getElementById("agents-card-grid");
        if (!container) return;
        container.innerHTML = agents.map((a) => {
          const isActive = a.status === "active";
          return `
            <div class="stat-card">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size: 0.75rem; color: var(--accent-blue); font-weight:700;">${escapeHtml(a.department)}</span>
                <span class="badge-status ${isActive ? "completed" : "pending"}">${isActive ? "AKTIF" : escapeHtml(String(a.status || "STANDBY").toUpperCase())}</span>
              </div>
              <div style="font-weight: 800; font-size: 1.05rem; margin-top: 8px;">${escapeHtml(a.name)}</div>
              <div style="font-size: 0.85rem; color: #fff; margin-bottom: 6px;">${escapeHtml(a.role)}</div>
              <p style="font-size: 0.78rem; color: var(--text-muted); line-height: 1.4;">${escapeHtml(a.description || "")}</p>
            </div>
          `;
        }).join("");
      }

      function renderResultBox(containerId: string, payload: unknown) {
        const el = document.getElementById(containerId);
        if (!el) return;
        el.innerHTML = `<pre class="log-box">${escapeHtml(JSON.stringify(payload, null, 2))}</pre>`;
      }

      // CEO Command submission
      const cmdInput = document.getElementById("ceo-command-input") as HTMLInputElement | null;
      const cmdBtn = document.getElementById("btn-send-ceo-command") as HTMLButtonElement | null;

      cmdBtn?.addEventListener("click", async () => {
        const text = cmdInput?.value.trim();
        if (!text || !cmdBtn) return;
        cmdBtn.disabled = true;
        cmdBtn.textContent = "Mengirim...";
        try {
          const resp = await apiFetch("/api/ceo/command", {
            method: "POST",
            body: JSON.stringify({ command: text }),
          });
          const data = await resp.json();
          if (resp.ok) {
            alert("Instruksi berhasil diproses oleh AI Manager!\n\n" + JSON.stringify(data.result?.summary || data.result?.message || data.result, null, 2));
            if (cmdInput) cmdInput.value = "";
            await Promise.all([loadSupabaseStats(), loadRecentTasks(), loadApiStatus()]);
          } else {
            alert(data.error || "Gagal memproses instruksi.");
          }
        } catch (e) {
          if ((e as Error).message !== "Unauthorized") {
            alert("Server AI Company lokal tidak terjangkau.");
          }
        } finally {
          cmdBtn.disabled = false;
          cmdBtn.textContent = "Kirim ke AI Manager";
        }
      });

      async function triggerCycle(cycle: string, resultBoxId?: string) {
        try {
          const resp = await apiFetch("/api/automation/trigger", {
            method: "POST",
            body: JSON.stringify({ cycle }),
          });
          const data = await resp.json();
          if (resp.ok) {
            if (resultBoxId) renderResultBox(resultBoxId, data.result);
            alert(`Siklus ${cycle} WIB berhasil dieksekusi!`);
            await Promise.all([loadSupabaseStats(), loadRecentTasks(), loadApiStatus()]);
          } else {
            alert(data.error || "Gagal mengeksekusi siklus.");
          }
        } catch (e) {
          if ((e as Error).message !== "Unauthorized") {
            alert("Jalankan server daemon di terminal:\npython -m automation.ai_company.cli server");
          }
        }
      }

      document.querySelectorAll<HTMLButtonElement>("[data-cycle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const cycle = btn.getAttribute("data-cycle") || "all";
          void triggerCycle(cycle);
        });
      });

      document.getElementById("btn-trigger-recruitment")?.addEventListener("click", () => {
        void triggerCycle("0500", "recruitment-result-box");
      });
      document.getElementById("btn-trigger-newsroom")?.addEventListener("click", () => {
        void triggerCycle("0700", "newsroom-result-box");
      });
      document.getElementById("btn-run-audit-now")?.addEventListener("click", () => {
        void triggerCycle("0800", "audit-results-box");
      });
      document.getElementById("btn-quick-report")?.addEventListener("click", () => {
        void triggerCycle("0800", "audit-results-box");
      });
      document.getElementById("btn-refresh-tasks")?.addEventListener("click", () => {
        void loadRecentTasks();
      });

      document.getElementById("btn-cleanup-expired")?.addEventListener("click", async () => {
        try {
          const resp = await apiFetch("/api/data/cleanup-expired", { method: "POST", body: "{}" });
          const data = await resp.json();
          if (resp.ok) {
            renderResultBox("cleanup-result-box", data.result);
            await loadSupabaseStats();
          } else {
            alert(data.error || "Gagal mengarsipkan lowongan kedaluwarsa.");
          }
        } catch (e) {
          if ((e as Error).message !== "Unauthorized") {
            alert("Server AI Company lokal tidak terjangkau.");
          }
        }
      });

      document.getElementById("btn-generate-calendar")?.addEventListener("click", async () => {
        try {
          const resp = await apiFetch("/api/ceo/command", {
            method: "POST",
            body: JSON.stringify({ command: "marketing promo" }),
          });
          const data = await resp.json();
          if (resp.ok) {
            renderResultBox("marketing-calendar-box", data.result);
          } else {
            alert(data.error || "Gagal membuat kalender promosi.");
          }
        } catch (e) {
          if ((e as Error).message !== "Unauthorized") {
            alert("Server AI Company lokal tidak terjangkau.");
          }
        }
      });

      // Jika ada sesi tersimpan, tetap verifikasi ke server sebelum membuka dashboard
      if (ceoPin) {
        void verifyAndUnlock(ceoPin, activeApiBase).then((ok) => {
          if (!ok) lockDashboard();
        });
      }
    </script>
  </body>
</html>
