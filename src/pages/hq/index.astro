        function getCurrentScheduledCycleWib(): { cycle: "0500" | "0700" | "0800" | null; label: string; nextLabel: string } {
          const parts = new Intl.DateTimeFormat("en-GB", {
            timeZone: "Asia/Jakarta",
            hour: "2-digit",
            minute: "2-digit",
            hour12: false,
          }).formatToParts(new Date());
          const hour = Number(parts.find((p) => p.type === "hour")?.value ?? 0);
          const minute = Number(parts.find((p) => p.type === "minute")?.value ?? 0);
          // Aktif selama jendela 20 menit di setiap jam jadwal (05:00, 07:00, 08:00, 12:00, 17:00 WIB)
          if (hour === 5 && minute < 20) return { cycle: "0500", label: "⚡ AKTIF: LOKER BONAFIT (05:00 WIB)", nextLabel: "07:00 WIB (Berita Pagi)" };
          if (hour === 7 && minute < 20) return { cycle: "0700", label: "⚡ AKTIF: BERITA PAGI (07:00 WIB)", nextLabel: "08:00 WIB (Audit)" };
          if (hour === 8 && minute < 20) return { cycle: "0800", label: "⚡ AKTIF: AUDIT & LAPORAN (08:00 WIB)", nextLabel: "12:00 WIB (Berita Siang)" };
          if (hour === 12 && minute < 20) return { cycle: "0700", label: "⚡ AKTIF: BERITA SIANG (12:00 WIB)", nextLabel: "17:00 WIB (Berita Sore)" };
          if (hour === 17 && minute < 20) return { cycle: "0700", label: "⚡ AKTIF: BERITA SORE (17:00 WIB)", nextLabel: "05:00 WIB (Loker Bonafit)" };

          let nextLabel = "05:00 WIB (Loker Bonafit)";
          if (hour >= 5 && hour < 7) nextLabel = "07:00 WIB (Berita Pagi)";
          else if (hour >= 7 && hour < 8) nextLabel = "08:00 WIB (Audit)";
          else if (hour >= 8 && hour < 12) nextLabel = "12:00 WIB (Berita Siang)";
          else if (hour >= 12 && hour < 17) nextLabel = "17:00 WIB (Berita Sore)";
          return { cycle: null, label: `💤 STANDBY HEMAT TOKEN (Berikutnya: ${nextLabel})`, nextLabel };
        }

        function spawnDataOrb(effectiveCycle: "0500" | "0700" | "0800" | null) {
          const pool = effectiveCycle
            ? FLOW_ROUTES.filter((r) => r.cycle === effectiveCycle)
            : FLOW_ROUTES;
          if (!pool.length) return;
          const route = pool[Math.floor(Math.random() * pool.length)];
          const a = getAgentById(route.from);
          const b = getAgentById(route.to);
          const p0 = new THREE.Vector3(a.x3d, 2.2, a.z3d);
          const p2 = new THREE.Vector3(b.x3d, 2.2, b.z3d);
          const mid = new THREE.Vector3((a.x3d + b.x3d) / 2, 4.4, (a.z3d + b.z3d) / 2);
          const curve = new THREE.QuadraticBezierCurve3(p0, mid, p2);
          const mat = new THREE.MeshStandardMaterial({
            color: new THREE.Color(route.color),
            emissive: new THREE.Color(route.color),
            emissiveIntensity: 1.2,
          });
          const mesh = new THREE.Mesh(orbGeo, mat);
          scene.add(mesh);
          orbs.push({ mesh, curve, route, progress: 0, speed: 0.011 + Math.random() * 0.007 });
        }

