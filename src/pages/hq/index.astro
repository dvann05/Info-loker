          bubbleSprite.material.dispose();
          bubbleSprite = createLabelSprite(THREE, `${ag.emoji} ${text}`, ag.color, true);
          bubbleSprite.position.set(ag.x3d, ag.isCeo ? 4.45 : 4.15, ag.z3d);
          scene.add(bubbleSprite);
        }

        // Resize handling
        threeResizeFn = () => {
          const w = canvas.clientWidth || 800;
          const h = canvas.clientHeight || 520;
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h, false);
        };
        threeResizeFn();

        // Pointer & Touch Orbit + Raycast Click
        const raycaster = new THREE.Raycaster();
        const pointerNdc = new THREE.Vector2();

        const onPointerDown = (e: PointerEvent) => {
          dragging = true;
          pointerMoved = false;
          dragStartX = e.clientX;
          dragStartY = e.clientY;
        };
        const onPointerMove = (e: PointerEvent) => {
          if (!dragging) return;
          const dx = e.clientX - dragStartX;
          const dy = e.clientY - dragStartY;
          if (Math.hypot(dx, dy) > 4) pointerMoved = true;
          dragStartX = e.clientX;
          dragStartY = e.clientY;
          autoOrbit = false;
          document.getElementById("btn-cam-orbit")?.classList.remove("active");
          camYaw -= dx * 0.0075;
          camPitch = Math.max(0.24, Math.min(1.22, camPitch + dy * 0.006));
        };
        const onPointerUp = (e: PointerEvent) => {
          if (!dragging) return;
          dragging = false;
          if (!pointerMoved) {
            const rect = canvas.getBoundingClientRect();
            pointerNdc.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
            pointerNdc.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
            raycaster.setFromCamera(pointerNdc, camera);
            const hits = raycaster.intersectObjects(clickTargets, false);
            if (hits.length > 0) {
              const id = hits[0].object.userData.agentId as string;
              if (id) {
                updateInspector(id);
                const ag = getAgentById(id);
                setBubble(id, ag.tasks[0]);
                addOfficeFeed("CEO Dandi", `Menginspeksi karakter Roblox ${ag.name}`, "#f59e0b");
              }
            }
          }
        };
        const onWheel = (e: WheelEvent) => {
          e.preventDefault();
          camDist = Math.max(9, Math.min(34, camDist + e.deltaY * 0.015));
        };

        canvas.addEventListener("pointerdown", onPointerDown);
        window.addEventListener("pointermove", onPointerMove);
        window.addEventListener("pointerup", onPointerUp);
        canvas.addEventListener("wheel", onWheel, { passive: false });

        // Titik Nongkrong / Pantry / Ngobrol / Jalan-Jalan di Kantor
        const OFFICE_WAYPOINTS = [
          { x: -9.3, z: -3.0, type: "coffee" },   // Pantry Mesin Kopi & Dispenser
          { x: -8.2, z: -6.0, type: "chat" },     // Sofa Lounge Kantor
          { x: -1.4, z: -0.6, type: "chat" },     // Lorong Tengah Kiri
          { x: 1.4, z: -0.6, type: "chat" },      // Lorong Tengah Kanan
          { x: -9.8, z: 1.8, type: "walk" },      // Depan Whiteboard
          { x: 9.6, z: 1.8, type: "walk" },       // Depan TV Monitor
          { x: 9.4, z: -3.0, type: "walk" },      // Depan Rak Buku Arsip
          { x: 0.0, z: 4.3, type: "walk" },       // Lorong Divisi Loker & Berita
        ];

        const IDLE_BUBBLES: Record<string, string[]> = {
          relax: ["Duduk santai tunggu jadwal 😌", "Istirahat sejenak, hemat token!", "Santai dulu sebelum jam tayang"],
          coffee: ["Ngopi dulu biar makin fokus ☕", "Ambil kopi hangat di pantry ☕", "Seruput kopi sambil cek info"],
          chat: ["Ngobrol strategi PT bonafit 💬", "Diskusi ide berita industri 💬", "Bahas keyword SEO bareng tim 💬"],
          walk: ["Jalan-jalan keliling kantor 🚶", "Regangkan kaki sebentar 🚶", "Cek suasana ruangan kantor 🚶"],
        };

        function assignNextIdleActivity(rig: any, nowMs: number) {
          rig.nextSwitchAt = nowMs + 7000 + Math.random() * 8000;
          if (rig.agent.isCeo) {
            // CEO bergantian antara duduk santai, ngopi di meja, dan berjalan santai di Ruang CEO
            const ceoActs = ["relax", "coffee", "walk"];
            rig.activity = ceoActs[Math.floor(Math.random() * ceoActs.length)];
            if (rig.activity === "walk") {
              rig.targetX = (Math.random() - 0.5) * 5.2;
              rig.targetZ = -6.6 - Math.random() * 1.4;
            } else {
              rig.targetX = rig.homeX;
              rig.targetZ = rig.homeZ;
            }
            return;
          }

          const acts = ["relax", "coffee", "chat", "walk"];
          const next = acts[Math.floor(Math.random() * acts.length)];
          rig.activity = next;

          if (next === "relax") {
            rig.targetX = rig.homeX;
            rig.targetZ = rig.homeZ;
          } else if (next === "coffee") {
            // 50% ngopi di pantry, 50% ngopi santai di meja sendiri
            if (Math.random() < 0.55) {
              rig.targetX = -9.2 + (Math.random() - 0.5) * 1.2;
              rig.targetZ = -3.0 + (Math.random() - 0.5) * 1.6;
            } else {
              rig.targetX = rig.homeX;
              rig.targetZ = rig.homeZ;
            }
          } else if (next === "chat") {
            const chatSpots = [
              { x: -7.6, z: -6.2, lx: -8.6, lz: -7.4 },
              { x: -1.1, z: -0.6, lx: 1.1, lz: -0.6 },
              { x: 1.1, z: -0.6, lx: -1.1, lz: -0.6 },
              { x: 0.0, z: 4.3, lx: 0.0, lz: 1.8 },
            ];
            const spot = chatSpots[Math.floor(Math.random() * chatSpots.length)];
            rig.targetX = spot.x + (Math.random() - 0.5) * 0.7;
            rig.targetZ = spot.z + (Math.random() - 0.5) * 0.7;
            rig.chatLookX = spot.lx;
            rig.chatLookZ = spot.lz;
          } else {
            const wp = OFFICE_WAYPOINTS[Math.floor(Math.random() * OFFICE_WAYPOINTS.length)];
            rig.targetX = wp.x + (Math.random() - 0.5) * 1.4;
            rig.targetZ = wp.z + (Math.random() - 0.5) * 1.4;
          }
        }

        // Main 60fps 3D Animation Loop
        const animate = (nowMs: number) => {
          officeRafId = requestAnimationFrame(animate);
          const t = nowMs * 0.001;

          if (!officePaused) {
            if (autoOrbit) camYaw += 0.0022;

            const sched = getCurrentScheduledCycleWib();
            const effectiveCycle = officeMode === "auto" ? sched.cycle : officeMode;
            const isWorkTime = effectiveCycle !== null;

            const modeBadge = document.getElementById("office-mode-badge");
            if (modeBadge) {
              const badgeText = officeMode === "auto"
                ? (sched.cycle ? sched.label : `☕ SANTAI DI KANTOR • Jadwal AI: ${sched.nextLabel}`)
                : `🎬 SIMULASI KERJA (${officeMode} WIB • 0 Token AI)`;
              if (modeBadge.dataset.last !== badgeText) {
                modeBadge.dataset.last = badgeText;
                modeBadge.innerHTML = `<span class="dot-live" style="background:${isWorkTime ? "#22c55e" : "#f59e0b"};"></span> ${escapeHtml(badgeText)}`;
              }
            }

            // Animate setiap karakter Roblox secara bervariasi!
            Object.values(agentRigs).forEach((rig: any, idx: number) => {
              const { roblox, selRing, agent } = rig;

              if (isWorkTime) {
                rig.targetX = rig.homeX;
                rig.targetZ = rig.homeZ;
                rig.activity = "work";
              } else if (nowMs > rig.nextSwitchAt) {
                assignNextIdleActivity(rig, nowMs);
              }

              // Gerakkan karakter menuju target (berjalan jika jauh dari target)
              const dx = rig.targetX - roblox.group.position.x;
              const dz = rig.targetZ - roblox.group.position.z;
              const dist = Math.hypot(dx, dz);
              const atHome = Math.hypot(rig.homeX - roblox.group.position.x, rig.homeZ - roblox.group.position.z) < 0.25;

              if (dist > 0.14) {
                // Sedang berjalan-jalan (classic Roblox walk animation!)
                const speed = isWorkTime ? 0.085 : 0.042;
                roblox.group.position.x += (dx / dist) * Math.min(speed, dist);
                roblox.group.position.z += (dz / dist) * Math.min(speed, dist);
                roblox.group.position.y = (agent.isCeo ? 0.29 : 0.05) + Math.abs(Math.sin(t * 9 + idx)) * 0.07;
                roblox.group.rotation.y = Math.atan2(dx, dz);

                const swing = Math.sin(t * 9 + idx) * 0.65;
                roblox.leftArm.rotation.x = swing;
                roblox.rightArm.rotation.x = -swing;
                roblox.leftLeg.rotation.x = -swing;
                roblox.rightLeg.rotation.x = swing;
                roblox.cup.visible = false;
              } else {
                // Sudah sampai di posisi tujuan
                roblox.group.position.y = rig.homeY;
                const seated = atHome && (rig.activity === "work" || rig.activity === "relax" || rig.activity === "coffee");

                if (seated) {
                  roblox.group.rotation.y = 0;
                  roblox.leftLeg.rotation.x = -Math.PI / 2.2;
                  roblox.rightLeg.rotation.x = -Math.PI / 2.2;

                  if (rig.activity === "work") {
                    // Mengetik cepat di keyboard
                    roblox.leftArm.rotation.x = -1.05 + Math.sin(t * 11 + idx * 1.4) * 0.16;
                    roblox.rightArm.rotation.x = -1.05 + Math.cos(t * 11 + idx * 1.4) * 0.16;
                    roblox.head.rotation.y = Math.sin(t * 1.8 + idx) * 0.14;
                    roblox.cup.visible = false;
                  } else if (rig.activity === "coffee") {
                    // Duduk sambil ngopi (angkat cangkir ke mulut berkala!)
                    const sip = (Math.sin(t * 2.2 + idx) + 1) * 0.5;
                    roblox.leftArm.rotation.x = -0.35;
                    roblox.rightArm.rotation.x = -0.95 - sip * 0.95;
                    roblox.head.rotation.x = -sip * 0.14;
                    roblox.head.rotation.y = Math.sin(t * 0.9 + idx) * 0.18;
                    roblox.cup.visible = true;
                  } else {
                    // Duduk santai bersandar
                    roblox.leftArm.rotation.x = -0.35 + Math.sin(t * 1.5 + idx) * 0.06;
                    roblox.rightArm.rotation.x = -0.35 - Math.sin(t * 1.5 + idx) * 0.06;
                    roblox.head.rotation.y = Math.sin(t * 0.8 + idx * 1.7) * 0.35;
                    roblox.head.rotation.x = Math.sin(t * 1.2 + idx) * 0.08;
                    roblox.cup.visible = false;
                  }
                } else {
                  // Berdiri di Pantry / Area Ngobrol / Keliling
                  roblox.leftLeg.rotation.x = 0;
                  roblox.rightLeg.rotation.x = 0;
                  if (rig.activity === "coffee") {
                    const sip = (Math.sin(t * 2.4 + idx) + 1) * 0.5;
                    roblox.leftArm.rotation.x = 0.08;
                    roblox.rightArm.rotation.x = -0.85 - sip * 0.95;
                    roblox.head.rotation.y = Math.sin(t * 1.1 + idx) * 0.25;
                    roblox.cup.visible = true;
                  } else if (rig.activity === "chat") {
                    // Mengobrol ekspresif: menghadap lawan bicara, angguk & gerak tangan
                    roblox.group.rotation.y = Math.atan2(rig.chatLookX - roblox.group.position.x, rig.chatLookZ - roblox.group.position.z);
                    roblox.leftArm.rotation.x = -0.45 + Math.sin(t * 5.2 + idx) * 0.32;
                    roblox.rightArm.rotation.x = -0.45 + Math.cos(t * 4.8 + idx) * 0.32;
                    roblox.head.rotation.x = Math.sin(t * 4.0 + idx) * 0.14;
                    roblox.head.rotation.y = Math.sin(t * 1.8 + idx) * 0.2;
                    roblox.cup.visible = false;
                  } else {
                    // Berhenti sejenak lihat whiteboard/TV sebelum jalan lagi
                    roblox.leftArm.rotation.x = Math.sin(t * 1.4 + idx) * 0.08;
                    roblox.rightArm.rotation.x = -Math.sin(t * 1.4 + idx) * 0.08;
                    roblox.head.rotation.y = Math.sin(t * 1.3 + idx) * 0.35;
                    roblox.cup.visible = false;
                  }
                }
              }

              selRing.visible = agent.id === selectedAgentId;
              if (selRing.visible) {
                const s = 1 + Math.sin(t * 5) * 0.06;
                selRing.scale.set(s, s, 1);
              }
            });

            // Blink Server Rack LEDs
            serverLeds.forEach((led, idx) => {
              const on = Math.sin(t * (isWorkTime ? 6 : 2.5) + idx * 1.7) > 0;
              led.material.emissiveIntensity = on ? 1.2 : 0.15;
            });

            // Walking Roblox Courier Bot selalu patroli keliling kantor
            courierT += 0.0042;
            if (courierT >= 1) {
              courierT = 0;
              courierFrom = courierTo;
              courierTo = Math.floor(Math.random() * OFFICE_AGENTS.length);
              if (courierTo === courierFrom) courierTo = (courierTo + 1) % OFFICE_AGENTS.length;
            }
            const aFrom = OFFICE_AGENTS[courierFrom];
            const aTo = OFFICE_AGENTS[courierTo];
            const cx = aFrom.x3d + (aTo.x3d - aFrom.x3d) * courierT;
            const cz = aFrom.z3d + (aTo.z3d - aFrom.z3d) * courierT;
            courierRig.group.position.set(cx, 0.05 + Math.abs(Math.sin(t * 10)) * 0.08, cz);
            courierRig.group.rotation.y = Math.atan2(aTo.x3d - aFrom.x3d, aTo.z3d - aFrom.z3d);
            const swing = Math.sin(t * 10) * 0.65;
            courierRig.leftArm.rotation.x = swing;
            courierRig.rightArm.rotation.x = -swing;
            courierRig.leftLeg.rotation.x = -swing;
            courierRig.rightLeg.rotation.x = swing;

            // Bola paket data 3D meluncur saat jam jadwal / simulasi
            if (isWorkTime && nowMs - lastOrbSpawn > 950 && orbs.length < 12) {
              lastOrbSpawn = nowMs;
              spawnDataOrb(effectiveCycle);
            }
            for (let i = orbs.length - 1; i >= 0; i--) {
              const o = orbs[i];
              o.progress += o.speed;
              if (o.progress >= 1) {
                scene.remove(o.mesh);
                o.mesh.material.dispose();
                if (Math.random() < 0.4) {
                  addOfficeFeed(getAgentById(o.route.from).shortName, o.route.label, o.route.color);
                }
                orbs.splice(i, 1);
                continue;
              }
              const pos = o.curve.getPoint(o.progress);
              o.mesh.position.copy(pos);
            }

            // Balon teks dinamis sesuai aktivitas karakter saat ini (kerja vs ngopi/ngobrol/santai/jalan)
            if (nowMs - lastBubbleTime > 3800) {
              lastBubbleTime = nowMs;
              const picked = OFFICE_AGENTS[Math.floor(Math.random() * OFFICE_AGENTS.length)];
              const rig = agentRigs[picked.id];
              let txt = "";
              if (isWorkTime) {
                txt = picked.id === "datamanager" && liveJobsCount > 0
                  ? `Sync ${liveJobsCount} loker & ${liveNewsCount} berita!`
                  : picked.tasks[Math.floor(Math.random() * picked.tasks.length)];
              } else {
                const actList = IDLE_BUBBLES[rig?.activity || "relax"] || IDLE_BUBBLES.relax;
                txt = actList[Math.floor(Math.random() * actList.length)];
              }
              setBubble(picked.id, txt);
              if (rig) {
                bubbleSprite.position.set(rig.roblox.group.position.x, 4.15, rig.roblox.group.position.z);
              }
            }

            // Gentle float on bubble
            bubbleSprite.position.y += Math.sin(t * 3.5) * 0.0025;
          }

          updateCamera();
          renderer.render(scene, camera);
        };

        officeRafId = requestAnimationFrame(animate);

        threeCleanup = () => {
          canvas.removeEventListener("pointerdown", onPointerDown);
          window.removeEventListener("pointermove", onPointerMove);
          window.removeEventListener("pointerup", onPointerUp);
          canvas.removeEventListener("wheel", onWheel);
          renderer.dispose();
          threeReady = false;
        };
      }

      function stopAiOfficeAnimation() {
        if (officeRafId !== null) {
          cancelAnimationFrame(officeRafId);
          officeRafId = null;
        }
        if (clockIntervalId !== null) {
          clearInterval(clockIntervalId);
          clockIntervalId = null;
        }
        if (threeCleanup) {
          threeCleanup();
          threeCleanup = null;
        }
      }

      window.addEventListener("resize", () => {
        if (isLoggedIn) resizeOfficeCanvas();
      });

      document.getElementById("btn-cam-iso")?.addEventListener("click", () => setCameraPresetFn?.("iso"));
      document.getElementById("btn-cam-ceo")?.addEventListener("click", () => setCameraPresetFn?.("ceo"));
      document.getElementById("btn-cam-orbit")?.addEventListener("click", () => setCameraPresetFn?.("orbit"));

      document.querySelectorAll<HTMLButtonElement>("[data-office-mode]").forEach((btn) => {
        btn.addEventListener("click", () => {
          document.querySelectorAll("[data-office-mode]").forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          const mode = (btn.getAttribute("data-office-mode") || "auto") as "auto" | "0500" | "0700" | "0800";
          officeMode = mode;
          const labelMap: Record<string, string> = {
            auto: "Mode Otomatis — Kantor AI 3D Roblox beroperasi penuh (Hemat AI)",
            "0500": "Siklus 05:00 WIB (1x/hari) — Kurasi 3–5 Loker Perusahaan Bonafit",
            "0700": "Siklus Berita Industri (3x/hari: Pagi/Siang/Sore) — SEO & Kata Kunci",
            "0800": "Siklus 08:00 WIB — Audit Sistem & Laporan CEO",
          };
          addOfficeFeed("AI Manager", labelMap[mode] || mode, "#38bdf8");
        });
      });

      document.getElementById("btn-office-toggle")?.addEventListener("click", (ev) => {
        officePaused = !officePaused;
        const btn = ev.currentTarget as HTMLButtonElement;
        btn.textContent = officePaused ? "▶ Lanjut" : "⏸ Jeda";
      });

      // =====================================================
      // DASHBOARD DATA & SUPABASE LIVE SYNC
      // =====================================================
      async function initDashboard() {
        const managerTime = document.getElementById("manager-time");
        if (managerTime) {
          managerTime.textContent = `${formatJakartaDate(new Date().toISOString())} (WIB)`;
        }
        renderOrgChart(
          OFFICE_AGENTS.filter((a) => !a.isCeo).map((a) => ({
            name: a.name,
            role: a.role,
            department: a.department,
            status: "active",
            description: a.desc,
          }))
        );
        await Promise.all([
          loadSupabaseStats(),
          loadApiStatus(),
          loadRecentTasks(),
        ]);
      }

      async function loadSupabaseStats() {
        const todayWib = getJakartaToday();
        try {
          const [jobsRes, newsRes, recentRes] = await Promise.all([
            supabase
              .from("jobs")
              .select("id", { count: "exact", head: true })
              .eq("status", "published")
              .not("deadline", "is", null)
              .gte("deadline", todayWib),
            supabase
              .from("news")
              .select("id", { count: "exact", head: true })
              .eq("status", "published"),
            supabase
              .from("jobs")
              .select("title,company_name,location,deadline,slug")
              .eq("status", "published")
              .not("deadline", "is", null)
              .gte("deadline", todayWib)
              .order("published_at", { ascending: false })
              .limit(8),
          ]);

          const activeJobs = jobsRes.count || 0;
          const publishedNews = newsRes.count || 0;
          liveJobsCount = activeJobs;
          liveNewsCount = publishedNews;

          const jobsEl = document.getElementById("stat-jobs-count");
          const newsEl = document.getElementById("stat-news-count");
          const officeJobsEl = document.getElementById("office-jobs-count");
          const officeNewsEl = document.getElementById("office-news-count");
          if (jobsEl) jobsEl.textContent = String(activeJobs);
          if (newsEl) newsEl.textContent = String(publishedNews);
          if (officeJobsEl) officeJobsEl.textContent = String(activeJobs);
          if (officeNewsEl) officeNewsEl.textContent = String(publishedNews);

          addOfficeFeed("AI Data Manager", `Data live Supabase tersinkron: ${activeJobs} loker aktif & ${publishedNews} berita terbit.`, "#06b6d4");

          const briefingEl = document.getElementById("manager-briefing-text");
          if (briefingEl) {
            briefingEl.textContent =
              `Selamat datang, CEO Dandimahesa. Database Supabase saat ini mencatat ${activeJobs} lowongan kerja aktif (batas pendaftaran >= ${todayWib} WIB) dan ${publishedNews} artikel berita terbit. Jadwal otomatis berjalan pada 05.00, 07.00, dan 08.00 WIB via GitHub Actions.`;
          }

          const tbody = document.getElementById("supabase-jobs-tbody");
          const recentJobs = recentRes.data || [];
          if (tbody) {
            if (!recentJobs.length) {
              tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: var(--text-muted);">Belum ada lowongan aktif saat ini.</td></tr>';
            } else {
              tbody.innerHTML = recentJobs.map((j) => `
                <tr>
                  <td><strong>${escapeHtml(j.title)}</strong></td>
                  <td>${escapeHtml(j.company_name)}</td>
                  <td>${escapeHtml(j.location)}</td>
                  <td>${escapeHtml(j.deadline ? formatJakartaDate(j.deadline) : "Tidak dibatasi")}</td>
                  <td><a href="${getJobDetailPath(j.slug)}" target="_blank" rel="noopener noreferrer" style="color: var(--accent-blue); text-decoration: none;">Lihat ↗</a></td>
                </tr>
              `).join("");
            }
          }
        } catch (e) {
          console.error("Gagal memuat statistik Supabase:", e);
        }
      }

      async function loadApiStatus() {
        const statusEl = document.getElementById("stat-system-status");
        const agentsEl = document.getElementById("stat-agents-count");

        try {
          const resp = await apiFetch("/api/status");
          if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
          const data = await resp.json();
          const metrics = data.metrics || {};

          if (statusEl) {
            statusEl.textContent = "🟢 ONLINE (LOKAL)";
            statusEl.style.color = "var(--accent-green)";
          }
          if (agentsEl) {
            const activeCount = metrics.active_agents_count ?? 9;
            const totalCount = metrics.total_agents_count ?? (data.agents?.length || 9);
            agentsEl.textContent = `${activeCount} / ${totalCount}`;
          }
          if (Array.isArray(data.agents) && data.agents.length) {
            renderOrgChart(data.agents);
          }
        } catch {
          if (statusEl) {
            statusEl.textContent = "☁️ CLOUD MODE";
            statusEl.style.color = "var(--accent-blue)";
          }
          if (agentsEl) agentsEl.textContent = "9 / 9";
        }
      }

      async function loadRecentTasks() {
        try {
          const resp = await apiFetch("/api/tasks");
          if (resp.ok) {
            const data = await resp.json();
            renderTaskRows(data.tasks || []);
          } else {
            renderTaskError("Mode Cloud aktif — otomatisasi berjalan terjadwal via GitHub Actions (05:00, 07:00, 08:00 WIB).");
          }
        } catch {
          renderTaskError("Mode Cloud aktif — otomatisasi berjalan terjadwal via GitHub Actions (05:00, 07:00, 08:00 WIB).");
        }
      }

      function renderTaskError(msg: string) {
        const row = `<tr><td colspan="5" style="text-align: center; color: var(--text-muted);">${escapeHtml(msg)}</td></tr>`;
        const tbody = document.getElementById("overview-tasks-tbody");
        const fullTbody = document.getElementById("full-tasks-tbody");
        if (tbody) tbody.innerHTML = row;
        if (fullTbody) fullTbody.innerHTML = row;
      }

      function renderTaskRows(tasks: any[]) {
        const tbody = document.getElementById("overview-tasks-tbody");
        const fullTbody = document.getElementById("full-tasks-tbody");
        const rows = tasks.slice(0, 15).map((t) => {
          const safeStatus = escapeHtml(String(t.status || "pending").toLowerCase());
          const timeLabel = t.completed_at
            ? formatJakartaDate(t.completed_at, { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" })
            : "-";
          return `
            <tr>
              <td><code>${escapeHtml(t.task_id)}</code></td>
              <td><strong>${escapeHtml(t.agent_name)}</strong></td>
              <td>${escapeHtml(t.title)}</td>
              <td><span class="badge-status ${safeStatus}">${escapeHtml(String(t.status || "").toUpperCase())}</span></td>
              <td>${escapeHtml(timeLabel)}</td>
            </tr>
          `;
        }).join("");

        const emptyRow = '<tr><td colspan="5" style="text-align: center; color: var(--text-muted);">Belum ada tugas tercatat.</td></tr>';
        if (tbody) tbody.innerHTML = rows || emptyRow;
        if (fullTbody) fullTbody.innerHTML = rows || emptyRow;
      }

      function renderOrgChart(agents: any[]) {
        const container = document.getElementById("agents-card-grid");
        if (!container) return;
        container.innerHTML = agents.map((a) => {
          const isActive = a.status === "active";
          return `
            <div class="stat-card">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size: 0.75rem; color: var(--accent-blue); font-weight:700;">${escapeHtml(a.department)}</span>
                <span class="badge-status ${isActive ? "completed" : "pending"}">${isActive ? "AKTIF" : escapeHtml(String(a.status || "STANDBY").toUpperCase())}</span>
              </div>
              <div style="font-weight: 800; font-size: 1.05rem; margin-top: 8px;">${escapeHtml(a.name)}</div>
              <div style="font-size: 0.85rem; color: #fff; margin-bottom: 6px;">${escapeHtml(a.role)}</div>
              <p style="font-size: 0.78rem; color: var(--text-muted); line-height: 1.4;">${escapeHtml(a.description || "")}</p>
            </div>
          `;
        }).join("");
      }

      function renderResultBox(containerId: string, payload: unknown) {
        const el = document.getElementById(containerId);
        if (!el) return;
        el.innerHTML = `<pre class="log-box">${escapeHtml(JSON.stringify(payload, null, 2))}</pre>`;
      }

      // CEO Command submission
      const cmdInput = document.getElementById("ceo-command-input") as HTMLInputElement | null;
      const cmdBtn = document.getElementById("btn-send-ceo-command") as HTMLButtonElement | null;

      cmdBtn?.addEventListener("click", async () => {
        const text = cmdInput?.value.trim();
        if (!text || !cmdBtn) return;
        cmdBtn.disabled = true;
        cmdBtn.textContent = "Mengirim...";
        try {
          const resp = await apiFetch("/api/ceo/command", {
            method: "POST",
            body: JSON.stringify({ command: text }),
          });
          const data = await resp.json();
          if (resp.ok) {
            alert("Instruksi berhasil diproses oleh AI Manager!\n\n" + JSON.stringify(data.result?.summary || data.result?.message || data.result, null, 2));
            if (cmdInput) cmdInput.value = "";
            await Promise.all([loadSupabaseStats(), loadRecentTasks(), loadApiStatus()]);
          } else {
            alert(data.error || "Gagal memproses instruksi.");
          }
        } catch {
          alert("Server AI Company lokal belum aktif. Jalankan di terminal: python -m automation.ai_company.cli server");
        } finally {
          cmdBtn.disabled = false;
          cmdBtn.textContent = "Kirim ke AI Manager";
        }
      });

      async function triggerCycle(cycle: string, resultBoxId?: string) {
        try {
          const resp = await apiFetch("/api/automation/trigger", {
            method: "POST",
            body: JSON.stringify({ cycle }),
          });
          const data = await resp.json();
          if (resp.ok) {
            if (resultBoxId) renderResultBox(resultBoxId, data.result);
            alert(`Siklus ${cycle} WIB berhasil dieksekusi!`);
            await Promise.all([loadSupabaseStats(), loadRecentTasks(), loadApiStatus()]);
          } else {
            alert(data.error || "Gagal mengeksekusi siklus.");
          }
        } catch {
          alert("Jalankan server daemon di terminal:\npython -m automation.ai_company.cli server");
        }
      }

      document.querySelectorAll<HTMLButtonElement>("[data-cycle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const cycle = btn.getAttribute("data-cycle") || "all";
          void triggerCycle(cycle);
        });
      });

      document.getElementById("btn-trigger-recruitment")?.addEventListener("click", () => {
        void triggerCycle("0500", "recruitment-result-box");
      });
      document.getElementById("btn-trigger-newsroom")?.addEventListener("click", () => {
        void triggerCycle("0700", "newsroom-result-box");
      });
      document.getElementById("btn-run-audit-now")?.addEventListener("click", () => {
        void triggerCycle("0800", "audit-results-box");
      });
      document.getElementById("btn-quick-report")?.addEventListener("click", () => {
        void triggerCycle("0800", "audit-results-box");
      });
      document.getElementById("btn-refresh-tasks")?.addEventListener("click", () => {
        void loadRecentTasks();
      });

      document.getElementById("btn-cleanup-expired")?.addEventListener("click", async () => {
        try {
          const resp = await apiFetch("/api/data/cleanup-expired", { method: "POST", body: "{}" });
          const data = await resp.json();
          if (resp.ok) {
            renderResultBox("cleanup-result-box", data.result);
            await loadSupabaseStats();
          } else {
            alert(data.error || "Gagal mengarsipkan lowongan kedaluwarsa.");
          }
        } catch {
          alert("Server AI Company lokal belum aktif.");
        }
      });

      document.getElementById("btn-generate-calendar")?.addEventListener("click", async () => {
        try {
          const resp = await apiFetch("/api/ceo/command", {
            method: "POST",
            body: JSON.stringify({ command: "marketing promo" }),
          });
          const data = await resp.json();
          if (resp.ok) {
            renderResultBox("marketing-calendar-box", data.result);
          } else {
            alert(data.error || "Gagal membuat kalender promosi.");
          }
        } catch {
          alert("Server AI Company lokal belum aktif.");
        }
      });

      // Buka otomatis jika sesi login CEO masih aktif di tab ini
      if (isLoggedIn) {
        unlockDashboard();
      }
    </script>
  </body>
</html>
