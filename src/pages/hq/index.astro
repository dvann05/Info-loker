      const OFFICE_AGENTS: OfficeAgent[] = [
        {
          id: "ceo",
          name: "Dandi Mahesa (CEO)",
          shortName: "CEO Dandi",
          role: "Founder & Chief Executive Officer",
          department: "Executive Suite",
          emoji: "👑",
          color: "#f59e0b",
          x3d: 0,
          z3d: -7.6,
          facing: 0,
          isCeo: true,
          desc: "Pemilik & pengambil keputusan utama InfoLokerKita. Memantau seluruh 9 divisi AI dari Ruang Eksekutif 3D.",
          tasks: ["Memantau 3-5 loker bonafit/hari", "Review 3 berita industri SEO/hari", "Pantau efisiensi kuota AI"],
        },
        {
          id: "manager",
          name: "AI Manager",
          shortName: "AI Manager",
          role: "Direktur Operasional (COO)",
          department: "Executive Ops",
          emoji: "🧠",
          color: "#38bdf8",
          x3d: -4.2,
          z3d: -3.2,
          facing: 0,
          desc: "Pusat koordinasi 8 divisi AI, mengatur jadwal hemat AI (Loker 1x/hari & Berita 3x/hari), dan melapor ke CEO.",
          tasks: ["Koordinasi siklus hemat AI", "Susun laporan harian WIB", "Pantau target 3-5 loker bonafit"],
        },
