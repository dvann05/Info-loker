    <!-- Interactive Client Script -->
    <script>
      import { supabase } from "../../lib/supabase";
      import { formatJakartaDate, getJakartaToday, getJobDetailPath } from "../../lib/seo";

      const DEFAULT_API_BASE = "http://127.0.0.1:8787";
      const HQ_AUTH_SALT = "infolokerkita-hq-v1:";
      const FALLBACK_USER_HASH = "a428618dff3dc754dc8c4bcbe51872607181d3ecdca150006235979463b1b888";
      const FALLBACK_PASS_HASH = "c70f2a9bf7f0310fc789dcd2017cf63312d9d608a8612a6854e039873fc40f09";

      let activeApiBase = (sessionStorage.getItem("hq_api_base") || DEFAULT_API_BASE).replace(/\/+$/, "");
      let ceoPin = sessionStorage.getItem("ceo_pin") || "";
      let isLoggedIn = sessionStorage.getItem("hq_ceo_session") === "1";

      const authModal = document.getElementById("auth-modal");
      const hqApp = document.getElementById("hq-app");
      const loginForm = document.getElementById("hq-login-form") as HTMLFormElement | null;
      const usernameInput = document.getElementById("hq-username-input") as HTMLInputElement | null;
      const passwordInput = document.getElementById("hq-password-input") as HTMLInputElement | null;
      const loginSubmit = document.getElementById("hq-login-submit") as HTMLButtonElement | null;
      const authErr = document.getElementById("auth-err");

      function escapeHtml(s: unknown): string {
        return String(s ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      async function sha256Hex(input: string): Promise<string> {
        const bytes = new TextEncoder().encode(input);
        const digest = await crypto.subtle.digest("SHA-256", bytes);
        return Array.from(new Uint8Array(digest))
          .map((b) => b.toString(16).padStart(2, "0"))
          .join("");
      }

      function showAuthError(message: string) {
        if (!authErr) return;
        authErr.textContent = message;
        authErr.style.display = "block";
      }

      function clearAuthError() {
        if (!authErr) return;
        authErr.textContent = "";
        authErr.style.display = "none";
      }

      function unlockDashboard() {
        isLoggedIn = true;
        sessionStorage.setItem("hq_ceo_session", "1");
        clearAuthError();
        if (authModal) authModal.style.display = "none";
        if (hqApp) hqApp.hidden = false;
        const cfgApi = document.getElementById("cfg-api-base") as HTMLInputElement | null;
        if (cfgApi) cfgApi.value = activeApiBase;
        const cfgPin = document.getElementById("cfg-api-pin") as HTMLInputElement | null;
        if (cfgPin && ceoPin) cfgPin.value = ceoPin;
        void initDashboard();
        startAiOfficeAnimation();
      }

      function lockDashboard(reason?: string) {
        isLoggedIn = false;
        sessionStorage.removeItem("hq_ceo_session");
        sessionStorage.removeItem("ceo_pin");
        ceoPin = "";
        stopAiOfficeAnimation();
        if (hqApp) hqApp.hidden = true;
        if (authModal) authModal.style.display = "flex";
        if (passwordInput) passwordInput.value = "";
        if (reason) showAuthError(reason);
      }

      async function verifyCeoLogin(username: string, password: string): Promise<boolean> {
        const cleanUser = username.trim();
        if (!cleanUser || !password) {
          showAuthError("Masukkan username dan password CEO terlebih dahulu.");
          return false;
        }

        // 1. Coba verifikasi via Cloudflare Worker endpoint (/api/hq-login)
        try {
          const resp = await fetch("/api/hq-login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ username: cleanUser, password }),
          });
          if (resp.ok) {
            const data = await resp.json();
            if (data && data.ok) {
              unlockDashboard();
              return true;
            }
          } else if (resp.status === 401) {
            showAuthError("Username atau password salah. Akses ditolak.");
            return false;
          }
        } catch {
          // Fallback ke verifikasi hash lokal saat astro dev tanpa worker
        }

        // 2. Fallback hash SHA-256 (untuk mode preview lokal astro dev)
        try {
          const [uHash, pHash] = await Promise.all([
            sha256Hex(HQ_AUTH_SALT + cleanUser.toLowerCase()),
            sha256Hex(HQ_AUTH_SALT + password),
          ]);
          if (uHash === FALLBACK_USER_HASH && pHash === FALLBACK_PASS_HASH) {
            unlockDashboard();
            return true;
          }
          showAuthError("Username atau password salah. Akses ditolak.");
          return false;
        } catch {
          showAuthError("Gagal memverifikasi kredensial di browser ini.");
          return false;
        }
      }

      loginForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!loginSubmit) return;
        const u = usernameInput?.value || "";
        const p = passwordInput?.value || "";
        loginSubmit.disabled = true;
        loginSubmit.textContent = "Memverifikasi...";
        try {
          await verifyCeoLogin(u, p);
        } finally {
          loginSubmit.disabled = false;
          loginSubmit.textContent = "Masuk ke Kantor AI";
        }
      });

      document.getElementById("btn-logout")?.addEventListener("click", () => {
        lockDashboard();
      });

      document.getElementById("btn-save-api-cfg")?.addEventListener("click", () => {
        const cfgApi = document.getElementById("cfg-api-base") as HTMLInputElement | null;
        const cfgPin = document.getElementById("cfg-api-pin") as HTMLInputElement | null;
        activeApiBase = (cfgApi?.value.trim() || DEFAULT_API_BASE).replace(/\/+$/, "");
        ceoPin = cfgPin?.value.trim() || "";
        sessionStorage.setItem("hq_api_base", activeApiBase);
        if (ceoPin) sessionStorage.setItem("ceo_pin", ceoPin);
        void loadApiStatus();
        void loadRecentTasks();
        alert("Konfigurasi server lokal disimpan. Memeriksa koneksi...");
      });

      async function apiFetch(path: string, options: RequestInit = {}) {
        const headers = new Headers(options.headers || {});
        if (ceoPin) headers.set("X-CEO-PIN", ceoPin);
        if (options.body && !headers.has("Content-Type")) {
          headers.set("Content-Type", "application/json");
        }
        return fetch(`${activeApiBase}${path}`, {
          ...options,
          headers,
        });
      }

      // Navigation tab switching
      const navButtons = document.querySelectorAll(".nav-btn");
      const tabSections = document.querySelectorAll(".tab-section");
      const pageTitle = document.getElementById("page-title");

      navButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          navButtons.forEach((b) => b.classList.remove("active"));
          tabSections.forEach((s) => s.classList.remove("active"));

          btn.classList.add("active");
          const tabId = btn.getAttribute("data-tab");
          const targetSection = document.getElementById(`tab-${tabId}`);
          if (targetSection) targetSection.classList.add("active");

          if (pageTitle) pageTitle.textContent = btn.textContent?.replace(/^[^\s]+\s+/, "") || "Kantor AI";
          document.getElementById("sidebar")?.classList.remove("open");

          if (tabId === "office") {
            resizeOfficeCanvas();
          }
        });
      });

      document.getElementById("menu-toggle")?.addEventListener("click", () => {
        document.getElementById("sidebar")?.classList.toggle("open");
      });

      // =====================================================
      // ANIMASI KANTOR AI 3D KARAKTER ROBLOX (THREE.JS WEBGL)
      // =====================================================
