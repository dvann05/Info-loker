      function getAgentById(id: string): OfficeAgent {
        return OFFICE_AGENTS.find((a) => a.id === id) || OFFICE_AGENTS[0];
      }

      function addOfficeFeed(agentName: string, message: string, color = "#38bdf8") {
        const feed = document.getElementById("office-activity-feed");
        if (!feed) return;
        const now = new Intl.DateTimeFormat("id-ID", {
          timeZone: "Asia/Jakarta",
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
        }).format(new Date());
        const item = document.createElement("div");
        item.className = "office-feed-item";
        item.style.borderLeftColor = color;
        item.innerHTML = `<time>${escapeHtml(now)}</time><strong>${escapeHtml(agentName)}:</strong> ${escapeHtml(message)}`;
        feed.prepend(item);
        while (feed.children.length > 18) {
          feed.lastElementChild?.remove();
        }
      }

      function updateInspector(agentId: string) {
        selectedAgentId = agentId;
        const agent = getAgentById(agentId);
        const avatarEl = document.getElementById("inspector-avatar");
        const nameEl = document.getElementById("inspector-name");
        const roleEl = document.getElementById("inspector-role");
        const descEl = document.getElementById("inspector-desc");
        const taskEl = document.getElementById("inspector-task");
        const statusEl = document.getElementById("inspector-status");

        if (avatarEl) {
          avatarEl.textContent = agent.emoji;
          avatarEl.style.borderColor = agent.color;
        }
        if (nameEl) nameEl.textContent = agent.name;
        if (roleEl) {
          roleEl.textContent = `${agent.role} · ${agent.department}`;
          roleEl.style.color = agent.color;
        }
        if (descEl) descEl.textContent = agent.desc;
        if (taskEl) {
          const dynamicTask = agent.id === "datamanager" && liveJobsCount > 0
            ? `Mengelola ${liveJobsCount} loker aktif & ${liveNewsCount} berita terbit`
            : agent.tasks[Math.floor(Date.now() / 5000) % agent.tasks.length];
          taskEl.textContent = dynamicTask;
        }
        if (statusEl) {
          statusEl.textContent = agent.isCeo ? "ONLINE (CEO)" : "AKTIF BEKERJA";
        }
      }

