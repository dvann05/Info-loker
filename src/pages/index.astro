---
import BaseLayout from "../layouts/BaseLayout.astro";
import { supabase } from "../lib/supabase";
import { formatJakartaDate, getJakartaToday, getJobDetailPath } from "../lib/seo";

const todayWib = getJakartaToday();
let initialJobs: Array<{
  slug: string;
  title: string;
  company_name: string | null;
  company_logo: string | null;
  location: string | null;
  employment_type: string | null;
  description: string | null;
  source_url: string | null;
  apply_url: string | null;
  published_at: string | null;
}> = [];

try {
  const { data } = await supabase
    .from("jobs")
    .select(
      "slug,title,company_name,company_logo,location,employment_type,description,source_url,apply_url,published_at"
    )
    .eq("status", "published")
    .not("slug", "is", null)
    .not("published_at", "is", null)
    .not("deadline", "is", null)
    .gte("deadline", todayWib)
    .order("published_at", { ascending: false })
    .order("slug", { ascending: true })
    .limit(12);
  initialJobs = (data ?? []).filter((j) => Boolean(j.slug));
} catch {
  initialJobs = [];
}
---

<BaseLayout
  title="Info Loker Kita — Portal Informasi Lowongan Kerja Indonesia Terbaru"
  description="Cari info lowongan kerja terbaru di Info Loker Kita berdasarkan posisi, perusahaan, dan lokasi di seluruh Indonesia. Periksa sumber resmi sebelum melamar."
>
  <header class="site-header">
    <div class="container navbar">
      <a class="brand" href="/" aria-label="Info Loker Kita beranda">
        <img src="/favicon.svg" alt="Logo Info Loker Kita" width="34" height="34" class="brand-logo-icon" />
        <span>Info Loker <span>Kita</span></span>
      </a>
      <nav class="nav-links" aria-label="Navigasi utama">
        <a href="/berita/">Berita</a>
        <a href="/lowongan/">Lowongan Kerja</a>
        <a href="#tentang">Tentang</a>
        <a href="#panduan">Panduan</a>
        <a class="nav-cta" href="/lowongan/">Cari Kerja ↗</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-content">
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          INFO LOKER KITA — INFORMASI KERJA RESMI
        </div>

        <h1>
          Temukan lowongan kerja<br />
          yang <span>tepat untukmu.</span>
        </h1>

        <p class="hero-description">
          Informasi lowongan kerja terbaru dari perusahaan resmi di Indonesia.
          Cari peluang karir berdasarkan posisi dan lokasi, serta periksa sumber resmi sebelum melamar.
        </p>

        <form class="search-panel" id="search-form" action="/lowongan/" method="get">
          <div class="search-field">
            <label for="keyword">Posisi atau perusahaan</label>
            <input
              id="keyword"
              name="q"
              type="search"
              placeholder="Contoh: Operator Produksi"
            />
          </div>

          <div class="search-field">
            <label for="province">Provinsi</label>
            <select id="province" name="provinsi"><option value="">Semua provinsi</option></select>
          </div>
          <div class="search-field">
            <label for="city">Kota/Kabupaten</label>
            <select id="city" name="kota" disabled><option value="">Pilih provinsi dahulu</option></select>
          </div>
          <div class="search-field">
            <label for="district">Kecamatan</label>
            <select id="district" name="kecamatan" disabled><option value="">Pilih kota/kabupaten dahulu</option></select>
          </div>

          <button class="btn btn-primary" type="submit">
            Cari Lowongan ↗
          </button>
        </form>

        <p class="hero-note">
          Selalu periksa informasi dan tautan rekrutmen resmi sebelum melamar. 100% gratis tanpa pungutan.
        </p>
      </div>
    </section>

    <section class="section categories-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <h2>Kategori Populer</h2>
            <p>Jelajahi lowongan berdasarkan sektor industri utama.</p>
          </div>
        </div>
        <div class="category-grid">
          <a href="/lowongan/?q=Operator+Produksi" class="category-chip">
            <span class="cat-icon">🏭</span>
            <span class="cat-info">
              <strong>Manufaktur & Pabrik</strong>
              <small>Operator, QA, Teknisi</small>
            </span>
          </a>
          <a href="/lowongan/?q=Gudang" class="category-chip">
            <span class="cat-icon">📦</span>
            <span class="cat-info">
              <strong>Gudang & Logistik</strong>
              <small>Staff Gudang, Driver</small>
            </span>
          </a>
          <a href="/lowongan/?q=Administrasi" class="category-chip">
            <span class="cat-icon">💼</span>
            <span class="cat-info">
              <strong>Administrasi</strong>
              <small>Admin, Data Entry, HR</small>
            </span>
          </a>
          <a href="/lowongan/?q=Sales" class="category-chip">
            <span class="cat-icon">🛒</span>
            <span class="cat-info">
              <strong>Ritel & Penjualan</strong>
              <small>Kasir, Pramuniaga, SPG</small>
            </span>
          </a>
          <a href="/lowongan/?q=Teknisi" class="category-chip">
            <span class="cat-icon">🔧</span>
            <span class="cat-info">
              <strong>Teknik & Otomotif</strong>
              <small>Mekanik, Maintenance</small>
            </span>
          </a>
          <a href="/lowongan/?q=IT" class="category-chip">
            <span class="cat-icon">💻</span>
            <span class="cat-info">
              <strong>Teknologi & IT</strong>
              <small>Staff IT, Desain</small>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="section" id="lowongan">
      <div class="container">
        <div class="section-heading">
          <div>
            <h2>Lowongan terbaru</h2>
            <p>Menampilkan {initialJobs.length} lowongan aktif terbaru dari Info Loker Kita.</p>
          </div>
          <a href="/lowongan/" class="section-link">Lihat semua lowongan →</a>
        </div>

        {initialJobs.length > 0 ? (
          <div id="job-list" class="job-grid">
            {initialJobs.map((job) => {
              const cleanDesc = (job.description || "").replace(/\\n/g, "\n").replace(/\n{3,}/g, "\n\n").trim();
              const snippet = cleanDesc.length > 140 ? `${cleanDesc.slice(0, 140).trimEnd()}…` : cleanDesc;
              const initials = (job.company_name || "PT")
                .split(/\s+/)
                .filter(Boolean)
                .slice(0, 2)
                .map((w) => w[0])
                .join("")
                .toUpperCase();
              return (
                <article class="job-card">
                  <div class="job-company">
                    <div class="company-logo">{initials}</div>
                    <span>{job.company_name || "Perusahaan tidak diketahui"}</span>
                  </div>
                  <h3><a href={getJobDetailPath(job.slug)}>{job.title}</a></h3>
                  <div class="job-meta-row">
                    <span class="job-badge job-badge-location">📍 {job.location || "Indonesia"}</span>
                    <span class="job-badge job-badge-type">{job.employment_type || "Penuh Waktu"}</span>
                    {job.published_at && (
                      <span class="job-badge job-badge-date">⏱ {formatJakartaDate(job.published_at, { day: "numeric", month: "short", year: "numeric" })}</span>
                    )}
                  </div>
                  <p class="job-description">{snippet}</p>
                  <div class="job-card-actions">
                    <a href={getJobDetailPath(job.slug)} class="job-source">Lihat detail →</a>
                    {job.source_url && (
                      <a href={job.source_url} target="_blank" rel="nofollow noopener noreferrer" class="job-source job-source-muted">Sumber resmi ↗</a>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="empty-state">
            <div class="empty-state-icon">💼</div>
            <h3 class="empty-state-title">Lihat daftar lowongan terbaru</h3>
            <p class="empty-state-desc">Buka halaman lowongan kerja untuk menelusuri seluruh peluang yang tersedia.</p>
            <a href="/lowongan/" class="btn btn-primary">Buka Daftar Lowongan →</a>
          </div>
        )}

        <div style="text-align: center; margin-top: 24px;">
          <a href="/lowongan/" class="btn btn-primary">Lihat Semua Lowongan Kerja →</a>
        </div>
      </div>
    </section>

    <section class="section" id="tentang">
      <div class="container">
        <div class="section-heading">
          <div>
            <h2>Mencari kerja lebih terarah</h2>
            <p>Informasi disusun supaya pencari kerja lebih mudah menemukan peluang yang relevan.</p>
          </div>
        </div>

        <div class="feature-grid">
          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true">⌕</div>
            <h3>Pencarian terarah</h3>
            <p>Temukan lowongan berdasarkan kata kunci dan lokasi kerja.</p>
          </article>

          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true">✓</div>
            <h3>Sumber rekrutmen</h3>
            <p>Periksa sumber dan tautan rekrutmen asli sebelum melamar.</p>
          </article>

          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true">◷</div>
            <h3>Tanggal yang jelas</h3>
            <p>Periksa tanggal publikasi dan batas pendaftaran lowongan.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="panduan">
      <div class="container">
        <div class="trust-banner">
          <div>
            <h2>Periksa sebelum melamar</h2>
            <p>
              Pastikan lowongan masih dibuka. Waspadai permintaan uang,
              biaya rekrutmen mencurigakan, dan tautan tidak resmi.
            </p>
          </div>

          <a
            class="btn"
            href="https://kemnaker.go.id/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Situs Kemnaker ↗
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-columns">
        <div class="footer-col brand-col">
          <a class="brand" href="/" aria-label="Info Loker Kita beranda">
            <img src="/favicon.svg" alt="Logo Info Loker Kita" width="34" height="34" class="brand-logo-icon" />
            <span>Info Loker <span>Kita</span></span>
          </a>
          <p class="footer-description">
            Info Loker Kita adalah portal informasi lowongan kerja resmi di Indonesia. Transparan, aman, dan 100% bebas biaya pungutan.
          </p>
          <div class="footer-badge">🛡️ Bebas Pungutan Biaya 100%</div>
        </div>

        <div class="footer-col">
          <h4>Navigasi Portal</h4>
          <ul class="footer-nav-list">
            <li><a href="/lowongan/">Cari Lowongan Kerja</a></li>
            <li><a href="/berita/">Berita Dunia Kerja</a></li>
            <li><a href="#tentang">Tentang Info Loker Kita</a></li>
            <li><a href="#panduan">Panduan Anti-Penipuan</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Kategori Lowongan</h4>
          <ul class="footer-nav-list">
            <li><a href="/lowongan/?q=Operator">Operator Produksi</a></li>
            <li><a href="/lowongan/?q=Gudang">Logistik & Gudang</a></li>
            <li><a href="/lowongan/?q=Admin">Administrasi Kantor</a></li>
            <li><a href="/lowongan/?q=Sales">Ritel & Pemasaran</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Verifikasi & Regulasi</h4>
          <p class="footer-text-muted">
            Info Loker Kita tidak pernah memungut biaya apapun dari pelamar kerja. Waspadai penipuan rekrutmen berbayar.
          </p>
          <a href="https://kemnaker.go.id" target="_blank" rel="noopener noreferrer" class="footer-external-link">
            Situs Resmi Kemnaker RI ↗
          </a>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© {new Date().getFullYear()} Info Loker Kita. Hak cipta dilindungi.</p>
        <p>Informasi bersumber dari portal resmi rekrutmen perusahaan dan Karirhub Kemnaker.</p>
      </div>
    </div>
  </footer>

  <script>
    import { setupLocationFilters } from "../scripts/location-filter";

    const form = document.querySelector<HTMLFormElement>("#search-form");
    const keywordInput = document.querySelector<HTMLInputElement>("#keyword");
    const provinceInput = document.querySelector<HTMLSelectElement>("#province");
    const cityInput = document.querySelector<HTMLSelectElement>("#city");
    const districtInput = document.querySelector<HTMLSelectElement>("#district");

    if (provinceInput && cityInput && districtInput) {
      void setupLocationFilters(provinceInput, cityInput, districtInput);
    }

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const params = new URLSearchParams();
      const q = (keywordInput?.value || "").trim();
      const prov = (provinceInput?.value || "").trim();
      const city = (cityInput?.value || "").trim();
      const dist = (districtInput?.value || "").trim();

      if (q) params.set("q", q);
      if (prov) params.set("provinsi", prov);
      if (city) params.set("kota", city);
      if (dist) params.set("kecamatan", dist);

      const qs = params.toString();
      window.location.href = qs ? `/lowongan/?${qs}` : "/lowongan/";
    });
  </script>
</BaseLayout>
