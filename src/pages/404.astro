---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Halaman Tidak Ditemukan (404) — Info Loker Kita"
  description="Halaman yang kamu cari tidak ditemukan atau lowongan sudah ditutup."
  robots="noindex,follow"
>
  <header class="site-header">
    <div class="container navbar">
      <a class="brand" href="/" aria-label="Info Loker Kita beranda">
        <img src="/favicon.svg" alt="Logo Info Loker Kita" width="38" height="38" class="brand-logo-icon" />
        <span>Info Loker <span>Kita</span></span>
      </a>
      <nav class="nav-links" aria-label="Navigasi utama">
        <a href="/">Beranda</a>
        <a href="/lowongan/">Lowongan</a>
        <a href="/berita/">Berita</a>
      </nav>
    </div>
  </header>

  <main class="section">
    <div class="container not-found-box">
      <div class="not-found-code" aria-hidden="true">404</div>
      <h1>Halaman Tidak Ditemukan</h1>
      <p>
        Alamat yang kamu buka mungkin salah, sudah dipindahkan, atau lowongan kerja tersebut telah melewati batas pendaftaran.
      </p>
      <div class="not-found-actions">
        <a href="/lowongan/" class="btn btn-primary">Lihat Lowongan Aktif</a>
        <a href="/berita/" class="btn btn-secondary">Baca Berita Kerja</a>
        <a href="/" class="btn btn-secondary">Kembali ke Beranda</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found-box {
    max-width: 620px;
    margin: 48px auto 72px;
    padding: 36px 24px;
    text-align: center;
    background: var(--card, #fff);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 18px;
  }

  .not-found-code {
    font-size: clamp(48px, 10vw, 72px);
    font-weight: 800;
    color: var(--primary, #0b6bcb);
    line-height: 1;
    margin-bottom: 12px;
  }

  .not-found-box h1 {
    margin: 0 0 12px;
    font-size: clamp(22px, 4vw, 30px);
  }

  .not-found-box p {
    margin: 0 0 24px;
    color: var(--muted, #64748b);
    line-height: 1.7;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>
