---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
}

const {
  title = "InfoLoker — Temukan Pekerjaanmu",
  description = "Temukan informasi lowongan kerja terbaru dari sumber resmi perusahaan.",
  ogImage,
  ogType = "website"
} = Astro.props;

const siteUrl = "https://infolokerkita.web.id";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImage = ogImage || `${siteUrl}/favicon.svg`;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "InfoLoker",
  url: `${siteUrl}/`,
  description,
  inLanguage: "id-ID",
  potentialAction: {
    "@type": "SearchAction",
    target: `${siteUrl}/lowongan/?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color" content="#0b6bcb" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="dns-prefetch" href="https://ucxwxmasnbidzofuoqks.supabase.co" />
    <link rel="preconnect" href="https://ucxwxmasnbidzofuoqks.supabase.co" crossorigin />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <title>{title}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="InfoLoker" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="id_ID" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
  </head>

  <body>
    <slot />

    <nav class="mobile-bottom-nav" aria-label="Navigasi Bawah">
      <a href="/" class="mobile-nav-item" aria-label="Beranda">
        <span class="mobile-nav-icon">🏠</span>
        <span class="mobile-nav-label">Beranda</span>
      </a>
      <a href="/lowongan/" class="mobile-nav-item" aria-label="Lowongan">
        <span class="mobile-nav-icon">💼</span>
        <span class="mobile-nav-label">Lowongan</span>
      </a>
      <a href="/berita/" class="mobile-nav-item" aria-label="Berita">
        <span class="mobile-nav-icon">📰</span>
        <span class="mobile-nav-label">Berita</span>
      </a>
      <a href="/#panduan" class="mobile-nav-item" aria-label="Panduan">
        <span class="mobile-nav-icon">🛡️</span>
        <span class="mobile-nav-label">Panduan</span>
      </a>
    </nav>

    <script>
      import "../scripts/visit";
    </script>
  </body>
</html>
