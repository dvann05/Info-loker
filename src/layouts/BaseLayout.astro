---
import "../styles/global.css";
import {
  DEFAULT_OG_IMAGE,
  SITE_URL,
  cleanMetaText,
  serializeJsonLd,
  toCanonicalUrl,
  toRasterImageUrl,
} from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  robots?: string;
  canonical?: string;
}

const DEFAULT_DESCRIPTION =
  "Info Loker Kita adalah portal informasi lowongan kerja resmi dan terpercaya di Indonesia. Temukan info loker terbaru dari sumber terverifikasi.";

const {
  title = "Info Loker Kita — Temukan Lowongan Kerja Terbaru",
  description = DEFAULT_DESCRIPTION,
  ogImage,
  ogType = "website",
  robots = "index,follow,max-image-preview:large",
  canonical,
} = Astro.props;

const metaDescription = cleanMetaText(description, 160) || DEFAULT_DESCRIPTION;
const canonicalUrl = canonical
  ? (canonical.startsWith("http") ? canonical : toCanonicalUrl(canonical))
  : toCanonicalUrl(Astro.url.pathname);
const socialImage = toRasterImageUrl(ogImage) || DEFAULT_OG_IMAGE;

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Info Loker Kita",
  alternateName: ["InfoLokerKita", "Info Loker", "InfoLoker"],
  url: `${SITE_URL}/`,
  description: DEFAULT_DESCRIPTION,
  inLanguage: "id-ID",
  potentialAction: {
    "@type": "SearchAction",
    target: `${SITE_URL}/lowongan/?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color" content="#0b6bcb" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="monetag" content="ed3564eb21fca0b79f2cd14463b176d1" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="dns-prefetch" href="https://ucxwxmasnbidzofuoqks.supabase.co" />
    <link rel="preconnect" href="https://ucxwxmasnbidzofuoqks.supabase.co" crossorigin />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Info Loker Kita" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="id_ID" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />

    <script
      type="application/ld+json"
      set:html={serializeJsonLd(websiteSchema)}
    />
    <slot name="head" />
  </head>

  <body>
    <slot />

    <nav class="mobile-bottom-nav" aria-label="Navigasi Bawah">
      <a href="/" class="mobile-nav-item" aria-label="Beranda">
        <span class="mobile-nav-icon">🏠</span>
        <span class="mobile-nav-label">Beranda</span>
      </a>
      <a href="/lowongan/" class="mobile-nav-item" aria-label="Lowongan">
        <span class="mobile-nav-icon">💼</span>
        <span class="mobile-nav-label">Lowongan</span>
      </a>
      <a href="/berita/" class="mobile-nav-item" aria-label="Berita">
        <span class="mobile-nav-icon">📰</span>
        <span class="mobile-nav-label">Berita</span>
      </a>
      <a href="/#panduan" class="mobile-nav-item" aria-label="Panduan">
        <span class="mobile-nav-icon">🛡️</span>
        <span class="mobile-nav-label">Panduan</span>
      </a>
    </nav>

    <script>
      import "../scripts/visit";
    </script>
  </body>
</html>
