---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "InfoLokerKita - Informasi Lowongan Kerja Terbaru",
  description = "Temukan informasi lowongan kerja terbaru dari berbagai perusahaan."
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <slot />

    <script is:inline>
      (() => {
        try {
          const ua = navigator.userAgent;

          const device = /tablet|ipad/i.test(ua)
            ? "Tablet"
            : /mobile|android|iphone/i.test(ua)
              ? "Mobile"
              : "Desktop";

          fetch("/api/visit", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              path: location.pathname,
              referrer: document.referrer,
              device
            }),
            keepalive: true
          }).catch(() => {});
        } catch {}
      })();
    </script>
  </body>
</html>
