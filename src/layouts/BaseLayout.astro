---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "InfoLoker — Temukan Pekerjaanmu",
  description = "Temukan informasi lowongan kerja terbaru dari sumber resmi perusahaan."
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b6bcb" />
    <meta name="description" content={description} />

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <slot />
  </body>
</html>
